### 5. Form Requirements Checklist

#### ✅ Basic Requirements
- [ ] Use React Hook Form for form management
- [ ] Include Yup validation schema
- [ ] Use Controller for MUI components
- [ ] Add proper error handling and display
- [ ] Include loading states during submission
- [ ] Disable submit button when form is invalid

#### ✅ Financial Form Specific
- [ ] Use currency formatting for monetary inputs
- [ ] Include proper validation for financial data
- [ ] Add clear error messages for validation failures
- [ ] Include confirmation steps for critical actions
- [ ] Add data masking for sensitive information

#### ✅ User Experience
- [ ] Provide clear field labels and placeholders
- [ ] Include helpful text and examples
- [ ] Add progress indicators for multi-step forms
- [ ] Include save draft functionality where appropriate
- [ ] Add form reset functionality
- [ ] Use MUI SX prop for all styling needs

#### ✅ Accessibility
- [ ] Include proper ARIA labels
- [ ] Ensure keyboard navigation works
- [ ] Add screen reader support
- [ ] Include proper focus management
- [ ] Test with accessibility tools

### 6. Testing Template
```javascript
// src/components/forms/__tests__/InvestmentForm.test.jsx
import React from 'react'
import { render, screen, fireEvent, waitFor } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import InvestmentForm from '../InvestmentForm'

describe('InvestmentForm', () => {
  it('validates required fields', async () => {
    const user = userEvent.setup()
    const mockSubmit = jest.fn()
    
    render(<InvestmentForm onSubmit={mockSubmit} />)
    
    const submitButton = screen.getByRole('button', { name: /create investment/i })
    await user.click(submitButton)
    
    expect(screen.getByText('Investment amount is required')).toBeInTheDocument()
    expect(screen.getByText('Duration is required')).toBeInTheDocument()
    expect(mockSubmit).not.toHaveBeenCalled()
  })

  it('submits form with valid data', async () => {
    const user = userEvent.setup()
    const mockSubmit = jest.fn()
    
    render(<InvestmentForm onSubmit={mockSubmit} />)
    
    await user.type(screen.getByLabelText(/investment amount/i), '10000')
    await user.type(screen.getByLabelText(/duration/i), '12')
    await user.selectOptions(screen.getByLabelText(/risk profile/i), 'moderate')
    
    const submitButton = screen.getByRole('button', { name: /create investment/i })
    await user.click(submitButton)
    
    await waitFor(() => {
      expect(mockSubmit).toHaveBeenCalledWith({
        amount: 10000,
        duration: 12,
        riskProfile: 'moderate',
        fundId: '',
        startDate: expect.any(String)
      })
    })
  })

  it('shows loading state during submission', async () => {
    const user = userEvent.setup()
    const mockSubmit = jest.fn(() => new Promise(resolve => setTimeout(resolve, 100)))
    
    render(<InvestmentForm onSubmit={mockSubmit} />)
    
    await user.type(screen.getByLabelText(/investment amount/i), '10000')
    await user.type(screen.getByLabelText(/duration/i), '12')
    
    const submitButton = screen.getByRole('button', { name: /create investment/i })
    await user.click(submitButton)
    
    expect(screen.getByText('Processing...')).toBeInTheDocument()
    expect(submitButton).toBeDisabled()
  })
})
