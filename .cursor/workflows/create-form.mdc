#### SIP Order Form
```javascript
// src/components/forms/SIPOrderForm.jsx
import React from 'react'
import { useForm, Controller } from 'react-hook-form'
import { yupResolver } from '@hookform/resolvers/yup'
import { sipOrderSchema } from 'schemas/sipOrderSchema'
import {
  Box,
  TextField,
  Button,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
  Typography,
  Alert,
  FormControlLabel,
  Checkbox
} from '@mui/material'

const SIPOrderForm = ({ onSubmit, loading = false, selectedFund }) => {
  const {
    control,
    handleSubmit,
    formState: { errors, isSubmitting },
    watch
  } = useForm({
    resolver: yupResolver(sipOrderSchema),
    defaultValues: {
      fundId: selectedFund?.id || '',
      amount: '',
      frequency: 'monthly',
      startDate: new Date().toISOString().split('T')[0],
      endDate: '',
      autoDebit: true,
      bankAccountId: ''
    }
  })

  const autoDebit = watch('autoDebit')

  return (
    <Box component="form" onSubmit={handleSubmit(onSubmit)}>
      <Typography variant="h6" gutterBottom>
        SIP Order Details
      </Typography>
      
      {selectedFund && (
        <Alert severity="info" sx={{ mb: 2 }}>
          Fund: {selectedFund.name} (NAV: ₹{selectedFund.nav})
        </Alert>
      )}
      
      {/* SIP Amount */}
      <Controller
        name="amount"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            label="SIP Amount (₹)"
            type="number"
            error={!!errors.amount}
            helperText={errors.amount?.message}
            fullWidth
            margin="normal"
            InputProps={{
              startAdornment: <Typography>₹</Typography>
            }}
          />
        )}
      />

      {/* Frequency */}
      <Controller
        name="frequency"
        control={control}
        render={({ field }) => (
          <FormControl fullWidth margin="normal" error={!!errors.frequency}>
            <InputLabel>SIP Frequency</InputLabel>
            <Select {...field} label="SIP Frequency">
              <MenuItem value="monthly">Monthly</MenuItem>
              <MenuItem value="quarterly">Quarterly</MenuItem>
              <MenuItem value="yearly">Yearly</MenuItem>
            </Select>
            {errors.frequency && (
              <Typography variant="caption" color="error">
                {errors.frequency.message}
              </Typography>
            )}
          </FormControl>
        )}
      />

      {/* Start Date */}
      <Controller
        name="startDate"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            label="Start Date"
            type="date"
            error={!!errors.startDate}
            helperText={errors.startDate?.message}
            fullWidth
            margin="normal"
            InputLabelProps={{ shrink: true }}
          />
        )}
      />

      {/* End Date */}
      <Controller
        name="endDate"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            label="End Date (Optional)"
            type="date"
            error={!!errors.endDate}
            helperText={errors.endDate?.message}
            fullWidth
            margin="normal"
            InputLabelProps={{ shrink: true }}
          />
        )}
      />

      {/* Auto Debit */}
      <Controller
        name="autoDebit"
        control={control}
        render={({ field }) => (
          <FormControlLabel
            control={
              <Checkbox
                {...field}
                checked={field.value}
              />
            }
            label="Enable Auto Debit"
          />
        )}
      />

      {/* Bank Account (conditional) */}
      {autoDebit && (
        <Controller
          name="bankAccountId"
          control={control}
          render={({ field }) => (
            <FormControl fullWidth margin="normal" error={!!errors.bankAccountId}>
              <InputLabel>Bank Account</InputLabel>
              <Select {...field} label="Bank Account">
                {/* Bank accounts will be populated from API */}
                <MenuItem value="account1">HDFC Bank - ****1234</MenuItem>
                <MenuItem value="account2">ICICI Bank - ****5678</MenuItem>
              </Select>
              {errors.bankAccountId && (
                <Typography variant="caption" color="error">
                  {errors.bankAccountId.message}
                </Typography>
              )}
            </FormControl>
          )}
        />
      )}

      {/* Submit Button */}
      <Button
        type="submit"
        variant="contained"
        fullWidth
        disabled={isSubmitting || loading}
        sx={{ mt: 3, mb: 2 }}
      >
        {isSubmitting || loading ? 'Creating SIP...' : 'Create SIP Order'}
      </Button>
    </Box>
  )
}

export default SIPOrderForm
```

