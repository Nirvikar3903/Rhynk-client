        <Grid item xs={12} sm={6}>
          <Controller
            name="personalDetails.panNumber"
            control={control}
            render={({ field }) => (
              <TextField
                {...field}
                label="PAN Number"
                error={!!errors.personalDetails?.panNumber}
                helperText={errors.personalDetails?.panNumber?.message}
                fullWidth
                required
                placeholder="ABCDE1234F"
              />
            )}
          />
        </Grid>
      </Grid>
      
      <Button
        variant="contained"
        onClick={onNext}
        disabled={!isValid}
