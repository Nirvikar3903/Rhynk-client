### 7. Testing Template
```javascript
// src/components/mui/__tests__/AppButtonComponent.test.jsx
import React from 'react'
import { render, screen, fireEvent } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import AppButtonComponent from '../AppButtonComponent'

describe('AppButtonComponent', () => {
  it('renders without crashing', () => {
    render(<AppButtonComponent>Click me</AppButtonComponent>)
    expect(screen.getByRole('button')).toBeInTheDocument()
  })

  it('handles click events', async () => {
    const user = userEvent.setup()
    const handleClick = jest.fn()
    
    render(
      <AppButtonComponent onClick={handleClick}>
        Click me
      </AppButtonComponent>
    )
    
    await user.click(screen.getByRole('button'))
    expect(handleClick).toHaveBeenCalledTimes(1)
  })

  it('shows loading state', () => {
    render(<AppButtonComponent loading>Click me</AppButtonComponent>)
    expect(screen.getByText('Loading...')).toBeInTheDocument()
  })

  it('applies custom sx styles', () => {
    render(
      <AppButtonComponent sx={{ color: 'red' }}>
        Click me
      </AppButtonComponent>
    )
    
    const button = screen.getByRole('button')
    expect(button).toHaveStyle('color: red')
  })
})
```