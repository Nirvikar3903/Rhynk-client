# Create API Service Workflow

## RTK Query Service Creation Checklist

### 1. File Structure
- **Location**: `src/store/api/`
- **Naming**: camelCase domain + `.apislice.js` suffix
- **Example**: `auth.apislice.js`, `conversations.apislice.js`, `musicRoom.apislice.js`
- **Pattern**: Use `transformResponse` with a parser from `store/parsers/`
  when the raw response needs reshaping (see [[create-parser]]) — skip the
  parser indirection for endpoints whose response is already exactly what
  components need.
- **Export**: Named export for the injected API slice, plus the generated
  hooks.

### 2. Base API Configuration

`src/store/index.js` and `src/store/api/` currently exist but are empty — no
`baseApi` has been written yet. This is the shape to create it in:

```javascript
// src/store/api/baseApi.js
import { createApi, fetchBaseQuery } from '@reduxjs/toolkit/query/react'

export const baseApi = createApi({
  reducerPath: 'api',
  baseQuery: fetchBaseQuery({
    baseUrl: import.meta.env.VITE_API_URL,
    prepareHeaders: (headers, { getState }) => {
      const token = getState().auth.accessToken
      if (token) {
        headers.set('authorization', `Bearer ${token}`)
      }
      return headers
    }
  }),
  tagTypes: ['User', 'Conversation', 'Message', 'MusicRoom', 'Song', 'Playlist', 'Notification'],
  endpoints: () => ({})
})
```

Note: Vite exposes env vars via `import.meta.env.VITE_*`, not
`process.env.REACT_APP_*` — this isn't a Create React App project. `axios` is
installed but unwired; `fetchBaseQuery` (native `fetch`) is the standard RTK
Query pairing and the default shown here — don't reach for axios in an
individual `*.apislice.js` file without a documented reason to swap the whole
`baseQuery`.

### 3. API Service Template — Conversations
```javascript
// src/store/api/conversations.apislice.js
import { baseApi } from './baseApi'
import { parseConversationsResponse } from 'store/parsers/conversations.parsers'

export const conversationsApi = baseApi.injectEndpoints({
  endpoints: (builder) => ({
    // Get conversation list
    getConversations: builder.query({
      query: () => '/conversations',
      transformResponse: parseConversationsResponse,
      providesTags: ['Conversation']
    }),

    // Get a single conversation
    getConversationById: builder.query({
      query: (id) => `/conversations/${id}`,
      providesTags: (result, error, id) => [{ type: 'Conversation', id }]
    }),

    // Create a conversation
    createConversation: builder.mutation({
      query: (body) => ({
        url: '/conversations',
        method: 'POST',
        body
      }),
      invalidatesTags: ['Conversation']
    }),

    // Get message history — cursor-paginated, per the LLD's compound
    // { created_at, _id } cursor (see the state-layer rules)
    getMessages: builder.query({
      query: ({ conversationId, cursor }) => ({
        url: `/conversations/${conversationId}/messages`,
        params: cursor ? { cursor } : undefined
      }),
      providesTags: (result, error, { conversationId }) => [
        { type: 'Message', id: conversationId }
      ]
    })
  })
})

export const {
  useGetConversationsQuery,
  useGetConversationByIdQuery,
  useCreateConversationMutation,
  useGetMessagesQuery
} = conversationsApi
```

### 4. Rhynk API Examples

#### Auth API — matches the documented 6-endpoint contract
```javascript
// src/store/api/auth.apislice.js
import { baseApi } from './baseApi'

export const authApi = baseApi.injectEndpoints({
  endpoints: (builder) => ({
    // POST /auth/register — { username, email, password }
    register: builder.mutation({
      query: (body) => ({
        url: '/auth/register',
        method: 'POST',
        body
      })
    }),

    // POST /auth/verify-otp — { email, otp, deviceId, deviceType }
    verifyOtp: builder.mutation({
      query: (body) => ({
        url: '/auth/verify-otp',
        method: 'POST',
        body
      }),
      invalidatesTags: ['User']
    }),

    // POST /auth/login — { email, password, deviceId, deviceType }
    login: builder.mutation({
      query: (body) => ({
        url: '/auth/login',
        method: 'POST',
        body
      }),
      invalidatesTags: ['User']
    }),

    // POST /auth/resend-otp — { email }
    resendOtp: builder.mutation({
      query: (body) => ({
        url: '/auth/resend-otp',
        method: 'POST',
        body
      })
    }),

    // POST /auth/refresh — { refreshToken, deviceId }
    // Note: refresh tokens rotate on every call — the client must overwrite
    // its stored refresh token with the new one, never reuse the old one.
    // See baseQueryWithReauth in the state-layer rules for where this plugs in.
    refresh: builder.mutation({
      query: (body) => ({
        url: '/auth/refresh',
        method: 'POST',
        body
      })
    }),

    // POST /auth/logout — { deviceId } + Authorization: Bearer <accessToken>
    logout: builder.mutation({
      query: (body) => ({
        url: '/auth/logout',
        method: 'POST',
        body
      }),
      invalidatesTags: ['User']
    })
  })
})

export const {
  useRegisterMutation,
  useVerifyOtpMutation,
  useLoginMutation,
  useResendOtpMutation,
  useRefreshMutation,
  useLogoutMutation
} = authApi
```

#### Music Room API
```javascript
// src/store/api/musicRoom.apislice.js
import { baseApi } from './baseApi'

export const musicRoomApi = baseApi.injectEndpoints({
  endpoints: (builder) => ({
    // GET /conversations/:id/room — current room state + queue
    getRoomQueue: builder.query({
      query: (roomId) => `/rooms/${roomId}/queue`,
      providesTags: (result, error, roomId) => [{ type: 'MusicRoom', id: roomId }]
    }),

    // Queue additions/removals go over this REST endpoint; live playback
    // control (play/pause/seek/skip) is DJ-only and goes over Socket.IO —
    // see [[07-realtime-sockets]] and [[08-music-rooms]], not RTK Query.
    addToQueue: builder.mutation({
      query: ({ roomId, songId }) => ({
        url: `/rooms/${roomId}/queue`,
        method: 'POST',
        body: { songId }
      }),
      invalidatesTags: (result, error, { roomId }) => [{ type: 'MusicRoom', id: roomId }]
    })
  })
})

export const { useGetRoomQueueQuery, useAddToQueueMutation } = musicRoomApi
```

### 5. Store Registration
```javascript
// src/store/index.js
import { configureStore } from '@reduxjs/toolkit'
import { baseApi } from './api/baseApi'
import authReducer from './slices/auth.slice'
import presenceReducer from './slices/presence.slice'

export const store = configureStore({
  reducer: {
    [baseApi.reducerPath]: baseApi.reducer,
    auth: authReducer,
    presence: presenceReducer
  },
  middleware: (getDefaultMiddleware) =>
    getDefaultMiddleware().concat(baseApi.middleware)
})
```

Note there is exactly **one** `baseApi` reducer entry, not one per domain —
every `*.apislice.js` file calls `baseApi.injectEndpoints(...)` on the same
shared instance rather than creating its own `createApi()` call, so only
`baseApi.middleware` needs concatenating, not a middleware per feature.

### 6. Verify the base path before hardcoding it

The PRD's API design section uses `/api/v1/...` while the currently
documented server auth routes are bare `/auth/...` — the two disagree on the
prefix. Check the live server's actual route registration for a given
feature before hardcoding either prefix into `VITE_API_URL` or a
`query: () => '/...'` path; don't assume `/api/v1` applies uniformly just
because the PRD states it.

### 7. API Service Requirements Checklist

#### ✅ Basic Requirements
- [ ] Use `baseApi.injectEndpoints`, not a separate `createApi()` call
- [ ] Configure proper `baseQuery` with auth headers (already done once, in
      `baseApi.js`)
- [ ] Define appropriate `tagTypes` for cache invalidation
- [ ] Export generated hooks
- [ ] Register `baseApi.reducer`/`baseApi.middleware` in the store — once

#### ✅ Rhynk Specific
- [ ] Match `docs/AUTH_MODULE.md`'s exact request/response shapes for auth
      endpoints — don't invent a different auth flow
- [ ] Keep Socket.IO event handling (typing, presence, room sync, calls) out
      of `store/api/` — RTK Query is REST-only, sockets live in containers or
      a future `src/app/socket.js` (see [[07-realtime-sockets]])
- [ ] Pass through the server's compound message cursor
      (`{ created_at, _id }`) unmodified rather than reconstructing it
      client-side
- [ ] Add a `baseQueryWithReauth` wrapper (see the state-layer rules) around
      401 handling instead of handling refresh ad hoc per component

#### ✅ Security
- [ ] Include authentication headers
- [ ] Add proper error handling for auth failures (`SESSION_REVOKED` must
      force a full logout, not a silent retry)
- [ ] Include token refresh logic
- [ ] Never log tokens or OTPs

### 8. Testing

No test runner (Vitest/Jest) is configured in this repo yet — the template
below is the intended shape once one is added, not something that runs today.

```javascript
// src/store/api/__tests__/conversations.apislice.test.js
import { renderHook, waitFor } from '@testing-library/react'
import { Provider } from 'react-redux'
import { configureStore } from '@reduxjs/toolkit'
import { conversationsApi } from '../conversations.apislice'
import { baseApi } from '../baseApi'

const createTestStore = () => {
  return configureStore({
    reducer: {
      [baseApi.reducerPath]: baseApi.reducer
    },
    middleware: (getDefaultMiddleware) =>
      getDefaultMiddleware().concat(baseApi.middleware)
  })
}

const wrapper = ({ children }) => {
  const store = createTestStore()
  return <Provider store={store}>{children}</Provider>
}

describe('conversationsApi', () => {
  it('should fetch conversations', async () => {
    const { result } = renderHook(
      () => conversationsApi.useGetConversationsQuery(),
      { wrapper }
    )

    await waitFor(() => {
      expect(result.current.isSuccess).toBe(true)
    })

    expect(result.current.data).toBeDefined()
  })
})
```

### 9. Common API Patterns

#### Query Endpoints
- `getConversations` - Fetch conversation list
- `getMessages` - Cursor-paginated message history
- `getRoomQueue` - Music-room queue/state
- `getNotifications` - Notification list

#### Mutation Endpoints
- `createConversation` - Start a new conversation
- `addToQueue` - Add a track to a room's queue
- `login` / `register` / `verifyOtp` / `refresh` / `logout` - Auth flow

#### Cache Invalidation
- Use `providesTags` for data that should be cached
- Use `invalidatesTags` for mutations that affect cached data
- Use specific `{ type, id }` tags for granular cache control

#### Error Handling
- Include proper error handling in `baseQuery`
- Map server error codes (`EMAIL_TAKEN`, `OTP_INVALID`, `REFRESH_LOCKED`,
  `SESSION_REVOKED`, …) to user-facing messages rather than surfacing raw
  HTTP status text
