### 7. Testing Template
```javascript
// src/store/api/__tests__/investmentApi.test.js
import { renderHook, waitFor } from '@testing-library/react'
import { Provider } from 'react-redux'
import { configureStore } from '@reduxjs/toolkit'
import { investmentApi } from '../investmentApi'

const createTestStore = () => {
  return configureStore({
    reducer: {
      [investmentApi.reducerPath]: investmentApi.reducer
    },
    middleware: (getDefaultMiddleware) =>
      getDefaultMiddleware().concat(investmentApi.middleware)
  })
}

const wrapper = ({ children }) => {
  const store = createTestStore()
  return <Provider store={store}>{children}</Provider>
}

describe('investmentApi', () => {
  it('should fetch funds', async () => {
    const { result } = renderHook(() => investmentApi.useGetFundsQuery(), { wrapper })

    await waitFor(() => {
      expect(result.current.isSuccess).toBe(true)
    })

    expect(result.current.data).toBeDefined()
  })

  it('should create SIP order', async () => {
    const { result } = renderHook(() => investmentApi.useCreateSIPOrderMutation(), { wrapper })

    const [createSIPOrder] = result.current

    await waitFor(async () => {
      const response = await createSIPOrder({
        fundId: '1',
        amount: 1000,
        frequency: 'monthly'
      })
      
      expect(response.data).toBeDefined()
    })
  })
})
```

### 8. Common API Patterns

#### Query Endpoints
- `getFunds` - Fetch fund list with filters
- `getFundById` - Fetch specific fund details
- `getPortfolio` - Fetch user portfolio
- `getTransactions` - Fetch transaction history

#### Mutation Endpoints
- `createSIPOrder` - Create SIP investment
- `createLumpsumOrder` - Create lumpsum investment
- `redeemInvestment` - Redeem investment
- `updateProfile` - Update user profile

#### Cache Invalidation
- Use `providesTags` for data that should be cached
- Use `invalidatesTags` for mutations that affect cached data
- Use specific tags for granular cache control

#### Error Handling
- Include proper error handling in baseQuery
- Add retry logic for failed requests
- Include proper error messages for user feedback