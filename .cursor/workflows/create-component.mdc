# Create Component Workflow

## Component Creation Checklist

### 1. File Structure
- **Location**: `src/components/` for regular components, `src/components/mui/` for MUI wrappers
- **Naming**: PascalCase with `Component` suffix
- **Example**: `FundCardComponent.jsx`, `AppButtonComponent.jsx`
- **Pattern**: Components are props-based only, NO business logic

### 2. Component Template
```javascript
// src/components/common/FundCardComponent.jsx
import React, { memo } from 'react'
import { Card, CardContent, Typography, Chip, Box } from '@mui/material'
import PropTypes from 'prop-types'
import { formatCurrency } from 'utils/currency.utils'

// Component scope
const RISK_COLORS = {
  Low: 'success',
  Moderate: 'warning', 
  High: 'error'
}

const FundCardComponent = ({ 
  fund, 
  onSelect, 
  isSelected = false,
  showDetails = true 
}) => {
  // States, refs, selectors, RTK Query hooks
  // (None for this component - it's props-based only)
  
  // useEffect hooks
  // (None for this component)
  
  // Other functions and logic
  const handleClick = () => {
    onSelect?.(fund.id)
  }

  const getRiskColor = (riskLevel) => {
    return RISK_COLORS[riskLevel] || 'default'
  }

  // Return/rendering
  return (
    <Card
      onClick={handleClick}
      sx={{
        cursor: 'pointer',
        border: isSelected ? '2px solid #1976d2' : '1px solid #e0e0e0',
        transition: 'all 0.2s ease-in-out',
        '&:hover': {
          boxShadow: 2,
          transform: 'translateY(-2px)'
        }
      }}
    >
      <CardContent>
        <Typography variant="h6" component="h3" gutterBottom>
          {fund.name}
        </Typography>
        
        <Box display="flex" justifyContent="space-between" alignItems="center" mb={1}>
          <Typography variant="body2" color="text.secondary">
            NAV
          </Typography>
          <Typography variant="h6" fontWeight="bold">
            {formatCurrency(fund.nav)}
          </Typography>
        </Box>

        {showDetails && (
          <>
            <Chip 
              label={fund.category} 
              size="small" 
              color="primary" 
              sx={{ mb: 1 }}
            />
            
            <Typography 
              variant="caption" 
              color="text.secondary"
              display="block"
            >
              Risk: {fund.riskLevel} • Returns: {fund.returns}%
            </Typography>
          </>
        )}
      </CardContent>
    </Card>
  )
}

FundCardComponent.propTypes = {
  fund: PropTypes.shape({
    id: PropTypes.string.isRequired,
    name: PropTypes.string.isRequired,
    nav: PropTypes.number.isRequired,
    category: PropTypes.string.isRequired,
    riskLevel: PropTypes.string.isRequired,
    returns: PropTypes.number.isRequired
  }).isRequired,
  onSelect: PropTypes.func,
  isSelected: PropTypes.bool,
  showDetails: PropTypes.bool
}

FundCardComponent.defaultProps = {
  isSelected: false,
  showDetails: true
}

export default memo(FundCardComponent)
```

