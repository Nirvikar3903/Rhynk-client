### 7. Usage Example
```javascript
// src/App.jsx
import { ThemeProvider, CssBaseline } from '@mui/material'
import theme from 'theme'
import AppButtonComponent from 'components/mui/AppButtonComponent'

const App = () => {
  return (
    <ThemeProvider theme={theme}>
      <CssBaseline />
      <AppButtonComponent variant="contained" size="large">
        Join Room
      </AppButtonComponent>
    </ThemeProvider>
  )
}

export default App
```
