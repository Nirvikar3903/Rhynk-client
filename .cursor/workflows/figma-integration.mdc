### 4. Component Mapping from Figma

#### Button Components
```javascript
// src/components/mui/AppButtonComponent.jsx
import React from 'react'
import { Button as MuiButton } from '@mui/material'
import PropTypes from 'prop-types'

const AppButtonComponent = ({ variant, size, children, ...props }) => {
  return (
    <MuiButton
      variant={variant}
      size={size}
      sx={{
        // Figma button styles
        textTransform: 'none',
        borderRadius: 2,
        fontWeight: 500,
        ...getButtonStyles(variant, size)
      }}
      {...props}
    >
      {children}
    </MuiButton>
  )
}

const getButtonStyles = (variant, size) => {
  const baseStyles = {
    borderRadius: 2,
    fontWeight: 500
  }
  
  const sizeStyles = {
    small: { padding: '0.5rem 1rem', fontSize: '0.875rem' },
    medium: { padding: '0.75rem 1.5rem', fontSize: '1rem' },
    large: { padding: '1rem 2rem', fontSize: '1.125rem' }
  }
  
  return {
    ...baseStyles,
    ...sizeStyles[size]
  }
}
```

#### Card Components
```javascript
// src/components/mui/AppCardComponent.jsx
import React from 'react'
import { Card as MuiCard, CardContent as MuiCardContent } from '@mui/material'
import PropTypes from 'prop-types'

const AppCardComponent = ({ elevation, children, ...props }) => {
  return (
    <MuiCard
      elevation={elevation}
      sx={{
        // Figma card styles
        borderRadius: 3,
        padding: 2,
        boxShadow: '0 2px 8px rgba(0, 0, 0, 0.1)',
        transition: 'all 0.2s ease-in-out',
        '&:hover': {
          boxShadow: '0 4px 16px rgba(0, 0, 0, 0.15)',
          transform: 'translateY(-2px)'
        }
      }}
      {...props}
    >
      <MuiCardContent sx={{ padding: 0 }}>
        {children}
      </MuiCardContent>
    </MuiCard>
  )
}
```

