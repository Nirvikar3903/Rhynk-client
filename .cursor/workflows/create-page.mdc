```javascript
// src/containers/KYCContainer.jsx
import React, { useState } from 'react'
import { useForm } from 'react-hook-form'
import { yupResolver } from '@hookform/resolvers/yup'
import { kycSchema } from 'schemas/kycSchema'
import { KYCForm } from 'components/kyc/KYCForm'
import { DocumentUpload } from 'components/kyc/DocumentUpload'
import { useCreateKYCMutation } from 'store/api/kycApi'

const KYCContainer = () => {
  const [currentStep, setCurrentStep] = useState(1)
  const [createKYC, { isLoading }] = useCreateKYCMutation()
  
  const {
    control,
    handleSubmit,
    formState: { errors, isValid },
    watch
  } = useForm({
    resolver: yupResolver(kycSchema),
    mode: 'onChange'
  })

  const handleFormSubmit = async (data) => {
    try {
      await createKYC(data).unwrap()
      setCurrentStep(3) // Success step
    } catch (error) {
      console.error('KYC submission failed:', error)
    }
  }

  const nextStep = () => setCurrentStep(prev => prev + 1)
  const prevStep = () => setCurrentStep(prev => prev - 1)

  return (
    <div>
      <h1>Complete Your KYC</h1>
      
      {currentStep === 1 && (
        <KYCForm
          control={control}
          errors={errors}
          onNext={nextStep}
          isValid={isValid}
        />
      )}
      
      {currentStep === 2 && (
        <DocumentUpload
          onBack={prevStep}
          onSubmit={handleSubmit(handleFormSubmit)}
          loading={isLoading}
        />
      )}
      
      {currentStep === 3 && (
        <div>
          <h2>KYC Submitted Successfully!</h2>
          <p>Your documents are under review. You'll be notified once approved.</p>
        </div>
      )}
    </div>
  )
}

export default KYCContainer
```

### 5. Route Registration
```javascript
// src/router/index.jsx
import React, { lazy, Suspense } from 'react'
import { Routes, Route } from 'react-router-dom'
import { Box, CircularProgress } from '@mui/material'

// Lazy load pages
const DashboardPage = lazy(() => import('pages/DashboardPage'))
const InvestmentPage = lazy(() => import('pages/InvestmentPage'))
const PortfolioPage = lazy(() => import('pages/PortfolioPage'))
const KYCPage = lazy(() => import('pages/KYCPage'))
const ProfilePage = lazy(() => import('pages/ProfilePage'))

const PageLoader = () => (
  <Box display="flex" justifyContent="center" alignItems="center" minHeight="400px">
    <CircularProgress />
  </Box>
)

const AppRouter = () => {
  return (
    <Suspense fallback={<PageLoader />}>
      <Routes>
        <Route path="/dashboard" element={<DashboardPage />} />
        <Route path="/investment" element={<InvestmentPage />} />
        <Route path="/portfolio" element={<PortfolioPage />} />
        <Route path="/kyc" element={<KYCPage />} />
        <Route path="/profile" element={<ProfilePage />} />
      </Routes>
    </Suspense>
  )
}

export default AppRouter
```

### 6. Page Requirements Checklist

#### ✅ Page Component
- [ ] Minimal component that delegates to container
- [ ] Single responsibility: route rendering
- [ ] No business logic or state management
- [ ] Use absolute imports

#### ✅ Container Component
- [ ] Contains all business logic
- [ ] Manages state and API calls
- [ ] Handles user interactions
- [ ] Renders reusable components
- [ ] Uses RTK Query for API calls
- [ ] Uses Redux for state management

#### ✅ Route Integration
- [ ] Register route in `src/router/index.jsx`
- [ ] Use lazy loading for performance
- [ ] Add proper loading states
- [ ] Include error boundaries

#### ✅ Financial App Specific
- [ ] Include proper error handling
- [ ] Add loading states for API calls
- [ ] Use financial data formatting utilities
- [ ] Include mobile responsiveness with MUI breakpoints
- [ ] Add proper validation
- [ ] Use MUI SX prop for all styling

### 7. Common Page Patterns

#### List Pages (Funds, Transactions)
- Display data in cards or tables
- Include search and filter functionality
- Add pagination for large datasets
- Include sorting options

#### Form Pages (KYC, Investment)
- Multi-step forms with validation
- Progress indicators
- Save draft functionality
- Clear error messaging

#### Detail Pages (Fund Details, Transaction Details)
- Display comprehensive information
- Include related actions
- Add sharing functionality
- Include navigation breadcrumbs

#### Dashboard Pages (Portfolio, Analytics)
- Summary cards with key metrics
- Interactive charts and graphs
- Quick action buttons
- Real-time data updates

