### 3. Container Template
```javascript
// src/containers/InvestmentContainer.jsx
import React, { useState, useEffect } from 'react'
import { useDispatch, useSelector } from 'react-redux'
import { useGetFundsQuery, useCreateSIPOrderMutation } from 'store/api/investment.apislice'
import { FundListComponent } from 'components/investment/FundListComponent'
import { InvestmentFormComponent } from 'components/investment/InvestmentFormComponent'
import { AppModalComponent } from 'components/mui/AppModalComponent'
import { setSelectedFund } from 'store/slices/investment.slice'

// Component scope
const DEFAULT_PAGE_SIZE = 20

const InvestmentContainer = () => {
  // States, refs, selectors, RTK Query hooks
  const [showForm, setShowForm] = useState(false)
  const [selectedFundId, setSelectedFundId] = useState(null)
  const [page, setPage] = useState(1)
  
  const dispatch = useDispatch()
  const { data: funds, error, isLoading } = useGetFundsQuery({ page })
  const [createSIPOrder, { isLoading: isSubmitting }] = useCreateSIPOrderMutation()
  const selectedFund = useSelector(state => state.investment.selectedFund)

  const handleFundSelect = (fundId) => {
    setSelectedFundId(fundId)
    const fund = funds?.find(f => f.id === fundId)
    if (fund) {
      dispatch(setSelectedFund(fund))
      setShowForm(true)
    }
  }

  const handleFormSubmit = async (formData) => {
    try {
      await createSIPOrder({
        fundId: selectedFundId,
        ...formData
      }).unwrap()
      
      setShowForm(false)
      setSelectedFundId(null)
      // Show success message
    } catch (error) {
      console.error('Failed to create SIP order:', error)
      // Show error message
    }
  }

  const handleCloseForm = () => {
    setShowForm(false)
    setSelectedFundId(null)
    dispatch(setSelectedFund(null))
  }

  if (isLoading) {
    return <div>Loading funds...</div>
  }

  if (error) {
    return <div>Error loading funds: {error.message}</div>
  }

  return (
    <div>
      <h1>Investment Options</h1>
      
      <FundList 
        funds={funds || []}
        onFundSelect={handleFundSelect}
      />
      
      <AppModal
        open={showForm}
        onClose={handleCloseForm}
        title="Create SIP Investment"
      >
        <InvestmentForm
          onSubmit={handleFormSubmit}
          loading={isSubmitting}
          selectedFund={selectedFund}
        />
      </AppModal>
    </div>
  )
}

export default InvestmentContainer
```

