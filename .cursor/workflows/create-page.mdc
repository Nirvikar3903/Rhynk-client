// src/containers/PortfolioContainer.jsx
import React, { useState, useEffect } from 'react'
import { useSelector } from 'react-redux'
import { useGetPortfolioQuery } from 'store/api/investmentApi'
import { PortfolioSummary } from 'components/portfolio/PortfolioSummary'
import { PortfolioChart } from 'components/portfolio/PortfolioChart'
import { InvestmentList } from 'components/portfolio/InvestmentList'

const PortfolioContainer = () => {
  const [timeRange, setTimeRange] = useState('1Y')
  
  const { data: portfolio, isLoading, error } = useGetPortfolioQuery()
  const user = useSelector(state => state.user.profile)

  if (isLoading) return <div>Loading portfolio...</div>
  if (error) return <div>Error: {error.message}</div>

  return (
    <div>
      <h1>Portfolio Overview</h1>
      <p>Welcome back, {user?.firstName}</p>
      
      <PortfolioSummary 
        portfolio={portfolio}
        timeRange={timeRange}
        onTimeRangeChange={setTimeRange}
      />
      
      <PortfolioChart 
        data={portfolio?.chartData}
        timeRange={timeRange}
      />
      
      <InvestmentList 
        investments={portfolio?.investments}
      />
    </div>
  )
}

export default PortfolioContainer
```

