# Create Page Workflow

## Page Creation Checklist

### 1. File Structure Pattern
- **Page**: `src/pages/PageNamePage.jsx` (minimal, delegates to a container)
- **Container**: `src/features/containers/<domain>/PageNameContainer.jsx`
  (business logic, RTK Query hooks, Redux connections — note this lives
  under `features/containers/<domain>/`, **not** a top-level `src/containers/`
  folder)
- **Components**: `src/components/<domain>/ComponentName.jsx` (UI only,
  props-based, rendered by the container)
- **Route**: Register in `src/router/index.jsx`

### 2. Page Template
```javascript
// src/pages/ConversationsPage.jsx
import React from 'react'
import ConversationsContainer from 'features/containers/conversations/ConversationsContainer'

const ConversationsPage = () => {
  return <ConversationsContainer />
}

export default ConversationsPage
```

### 3. Container Template
```javascript
// src/features/containers/conversations/ConversationsContainer.jsx
import React, { useState } from 'react'
import { useDispatch, useSelector } from 'react-redux'
import { useGetConversationsQuery, useCreateConversationMutation } from 'store/api/conversations.apislice'
import ConversationList from 'components/conversations/ConversationList'
import NewConversationForm from 'components/conversations/NewConversationForm'
import AppModalComponent from 'components/mui/AppModalComponent'
import { setActiveConversationId } from 'store/slices/presence.slice'

// Component scope
const DEFAULT_PAGE_SIZE = 20

const ConversationsContainer = () => {
  // States, refs, selectors, RTK Query hooks
  const [showNewConversationModal, setShowNewConversationModal] = useState(false)

  const dispatch = useDispatch()
  const { data: conversations, error, isLoading } = useGetConversationsQuery()
  const [createConversation, { isLoading: isCreating }] = useCreateConversationMutation()
  const activeConversationId = useSelector((state) => state.presence?.activeConversationId)

  const handleConversationSelect = (conversationId) => {
    dispatch(setActiveConversationId(conversationId))
  }

  const handleCreateConversation = async (formData) => {
    try {
      await createConversation(formData).unwrap()
      setShowNewConversationModal(false)
    } catch (error) {
      console.error('Failed to create conversation:', error)
    }
  }

  if (isLoading) {
    return <div>Loading conversations…</div>
  }

  if (error) {
    return <div>Error loading conversations: {error.message}</div>
  }

  return (
    <div>
      <h1>Conversations</h1>

      <ConversationList
        conversations={conversations || []}
        activeConversationId={activeConversationId}
        onSelect={handleConversationSelect}
      />

      <AppModalComponent
        open={showNewConversationModal}
        onClose={() => setShowNewConversationModal(false)}
        title="New Conversation"
      >
        <NewConversationForm
          onSubmit={handleCreateConversation}
          loading={isCreating}
        />
      </AppModalComponent>
    </div>
  )
}

export default ConversationsContainer
```

