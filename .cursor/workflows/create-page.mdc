```javascript
// src/features/containers/music-rooms/MusicRoomContainer.jsx
import React from 'react'
import { useSelector } from 'react-redux'
import { useGetRoomQueueQuery } from 'store/api/musicRoom.apislice'
import RoomMemberList from 'components/music-rooms/RoomMemberList'
import SongQueue from 'components/music-rooms/SongQueue'
import PlaybackControls from 'components/music-rooms/PlaybackControls'

const MusicRoomContainer = ({ roomId }) => {
  const { data: queue, isLoading, error } = useGetRoomQueueQuery(roomId)
  const currentUser = useSelector((state) => state.auth.user)

  if (isLoading) return <div>Loading room…</div>
  if (error) return <div>Error: {error.message}</div>

  const isDj = queue?.djUserId === currentUser?.id

  return (
    <div>
      <h1>Music Room</h1>

      <RoomMemberList members={queue?.members || []} djUserId={queue?.djUserId} />

      <SongQueue tracks={queue?.tracks || []} />

      {/* DJ-only controls are hidden client-side for non-DJs, but the
          server is the real enforcement boundary — see [[08-music-rooms]] */}
      {isDj && <PlaybackControls roomId={roomId} />}
    </div>
  )
}

export default MusicRoomContainer
```

