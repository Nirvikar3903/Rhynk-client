# Create Redux Slice Workflow

## Redux Slice Creation Checklist

### 1. File Structure
- **Location**: `src/store/slices/`
- **Naming**: camelCase with `.slice.js` suffix
- **Example**: `user.slice.js`, `investment.slice.js`
- **Pattern**: Each slice manages its own persistence
- **Export**: Named exports for actions and selectors, default export for reducer

### 2. Slice Template
```javascript
// src/store/slices/investmentSlice.js
import { createSlice, createSelector } from '@reduxjs/toolkit'

const initialState = {
  funds: [],
  selectedFund: null,
  portfolio: [],
  watchlist: [],
  loading: false,
  error: null,
  lastUpdated: null
}

const investmentSlice = createSlice({
  name: 'investment',
  initialState,
  reducers: {
    // Fund actions
    setFunds: (state, action) => {
      state.funds = action.payload
      state.lastUpdated = new Date().toISOString()
    },
    
    setSelectedFund: (state, action) => {
      state.selectedFund = action.payload
    },
    
    updateFund: (state, action) => {
      const { id, updates } = action.payload
      const fundIndex = state.funds.findIndex(fund => fund.id === id)
      if (fundIndex !== -1) {
        state.funds[fundIndex] = { ...state.funds[fundIndex], ...updates }
      }
    },
    
    // Portfolio actions
    setPortfolio: (state, action) => {
      state.portfolio = action.payload
    },
    
    addToPortfolio: (state, action) => {
      state.portfolio.push(action.payload)
    },
    
    updatePortfolioItem: (state, action) => {
      const { id, updates } = action.payload
      const itemIndex = state.portfolio.findIndex(item => item.id === id)
      if (itemIndex !== -1) {
        state.portfolio[itemIndex] = { ...state.portfolio[itemIndex], ...updates }
      }
    },
    
    removeFromPortfolio: (state, action) => {
      state.portfolio = state.portfolio.filter(item => item.id !== action.payload)
    },
    
    // Watchlist actions
    addToWatchlist: (state, action) => {
      const fundId = action.payload
      if (!state.watchlist.includes(fundId)) {
        state.watchlist.push(fundId)
      }
    },
    
    removeFromWatchlist: (state, action) => {
      const fundId = action.payload
      state.watchlist = state.watchlist.filter(id => id !== fundId)
    },
    
    // Loading and error actions
    setLoading: (state, action) => {
      state.loading = action.payload
    },
    
    setError: (state, action) => {
      state.error = action.payload
    },
    
    clearError: (state) => {
      state.error = null
    },
    
    // Reset actions
    resetInvestment: () => initialState,
    
    resetPortfolio: (state) => {
      state.portfolio = []
    }
  }
})

// Export actions
export const {
  setFunds,
  setSelectedFund,
  updateFund,
  setPortfolio,
  addToPortfolio,
  updatePortfolioItem,
  removeFromPortfolio,
  addToWatchlist,
  removeFromWatchlist,
  setLoading,
  setError,
  clearError,
  resetInvestment,
  resetPortfolio
} = investmentSlice.actions

// Basic selectors
export const selectFunds = (state) => state.investment.funds
export const selectSelectedFund = (state) => state.investment.selectedFund
export const selectPortfolio = (state) => state.investment.portfolio
export const selectWatchlist = (state) => state.investment.watchlist
export const selectInvestmentLoading = (state) => state.investment.loading
export const selectInvestmentError = (state) => state.investment.error
export const selectLastUpdated = (state) => state.investment.lastUpdated

// Memoized selectors
export const selectFundsByCategory = createSelector(
  [selectFunds, (state, category) => category],
  (funds, category) => funds.filter(fund => fund.category === category)
)

export const selectFundsByRiskLevel = createSelector(
  [selectFunds, (state, riskLevel) => riskLevel],
  (funds, riskLevel) => funds.filter(fund => fund.riskLevel === riskLevel)
)

export const selectWatchlistFunds = createSelector(
  [selectFunds, selectWatchlist],
  (funds, watchlist) => funds.filter(fund => watchlist.includes(fund.id))
)

export const selectPortfolioValue = createSelector(
  [selectPortfolio],
  (portfolio) => {
    return portfolio.reduce((total, item) => {
      return total + (item.units * item.currentPrice)
    }, 0)
  }
)

export const selectPortfolioGain = createSelector(
  [selectPortfolio],
  (portfolio) => {
    const totalValue = portfolio.reduce((total, item) => {
      return total + (item.units * item.currentPrice)
    }, 0)
    
    const totalInvested = portfolio.reduce((total, item) => {
      return total + item.investedAmount
    }, 0)
    
    return totalValue - totalInvested
  }
)

export const selectPortfolioGainPercentage = createSelector(
  [selectPortfolioValue, selectPortfolioGain],
  (totalValue, totalGain) => {
    const totalInvested = totalValue - totalGain
    return totalInvested > 0 ? (totalGain / totalInvested) * 100 : 0
  }
)

export const selectTopPerformingFund = createSelector(
  [selectPortfolio],
  (portfolio) => {
    if (!portfolio.length) return null
    
    return portfolio.reduce((top, item) => {
      const gain = (item.currentPrice - item.averagePrice) / item.averagePrice
      const topGain = top ? (top.currentPrice - top.averagePrice) / top.averagePrice : -1
      return gain > topGain ? item : top
    }, null)
  }
)

export default investmentSlice.reducer
```

