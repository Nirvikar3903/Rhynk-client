#### Advanced Persist Configuration
```javascript
// src/store/advancedPersistConfig.js
import storage from 'redux-persist/lib/storage'
import { persistReducer, createTransform } from 'redux-persist'

// Transform for sensitive data
const encryptTransform = createTransform(
  // Transform state on its way to being serialized and persisted
  (inboundState, key) => {
    if (key === 'user' && inboundState.profile) {
      // Encrypt sensitive user data
      return {
        ...inboundState,
        profile: {
          ...inboundState.profile,
          // Don't persist sensitive fields
          ssn: undefined,
          bankDetails: undefined
        }
      }
    }
    return inboundState
  },
  // Transform state being rehydrated
  (outboundState, key) => {
    return outboundState
  },
  // Define which reducers this transform runs on
  { whitelist: ['user'] }
)

// Financial data persist config with transforms
export const financialPersistConfig = {
  key: 'financial',
  storage,
  whitelist: ['portfolio', 'watchlist'],
  transforms: [encryptTransform],
  // Persist only specific fields
  stateReconciler: (inboundState, originalState, reducedState) => {
    return {
      ...reducedState,
      portfolio: inboundState.portfolio || [],
      watchlist: inboundState.watchlist || []
    }
  }
}

// Time-based persistence (expire after 7 days)
export const timeBasedPersistConfig = {
  key: 'user',
  storage,
  whitelist: ['preferences'],
  // Custom storage with expiration
  storage: {
    ...storage,
    getItem: (key) => {
      const item = storage.getItem(key)
      if (!item) return null
      
      const parsed = JSON.parse(item)
      const now = new Date().getTime()
      
      if (parsed.timestamp && now - parsed.timestamp > 7 * 24 * 60 * 60 * 1000) {
        storage.removeItem(key)
        return null
      }
      
      return item
    },
    setItem: (key, value) => {
      const item = {
        ...JSON.parse(value),
        timestamp: new Date().getTime()
      }
      storage.setItem(key, JSON.stringify(item))
    }
  }
}
