#### Persist with Custom Storage
```javascript
// src/store/customStorage.js
import { createTransform } from 'redux-persist'

// Custom storage for different data types
export const createCustomStorage = () => {
  const memoryStorage = {}
  
  return {
    getItem: (key) => {
      return new Promise((resolve) => {
        // Check localStorage first
        const item = localStorage.getItem(key)
        if (item) {
          resolve(item)
          return
        }
        
        // Check memory storage
        const memoryItem = memoryStorage[key]
        if (memoryItem) {
          resolve(JSON.stringify(memoryItem))
          return
        }
        
        resolve(null)
      })
    },
    
    setItem: (key, value) => {
      return new Promise((resolve) => {
        try {
          const parsed = JSON.parse(value)
          
          // Store sensitive data in memory only
          if (key.includes('auth') || key.includes('token')) {
            memoryStorage[key] = parsed
          } else {
            localStorage.setItem(key, value)
          }
          
          resolve()
        } catch (error) {
          console.error('Storage setItem error:', error)
          resolve()
        }
      })
    },
    
    removeItem: (key) => {
      return new Promise((resolve) => {
        localStorage.removeItem(key)
        delete memoryStorage[key]
        resolve()
      })
    }
  }
}

// Use custom storage
export const customStoragePersistConfig = {
  key: 'root',
  storage: createCustomStorage(),
  whitelist: ['user', 'investment']
}
```

### 5. Financial App Persist Example
```javascript
// src/store/financialPersistConfig.js
import storage from 'redux-persist/lib/storage'
import { persistReducer, createTransform } from 'redux-persist'
import { encrypt, decrypt } from 'utils/cryptoService'

// Transform for encrypting sensitive financial data
const financialDataTransform = createTransform(
  // Outbound: encrypt data before storing
  (inboundState, key) => {
    if (key === 'investment' && inboundState.portfolio) {
      return {
        ...inboundState,
        portfolio: inboundState.portfolio.map(item => ({
          ...item,
          // Encrypt sensitive financial data
          investedAmount: encrypt(item.investedAmount.toString()),
          currentValue: encrypt(item.currentValue.toString())
        }))
      }
    }
    return inboundState
  },
  // Inbound: decrypt data when rehydrating
  (outboundState, key) => {
    if (key === 'investment' && outboundState.portfolio) {
      return {
        ...outboundState,
        portfolio: outboundState.portfolio.map(item => ({
          ...item,
          // Decrypt sensitive financial data
          investedAmount: parseFloat(decrypt(item.investedAmount)),
          currentValue: parseFloat(decrypt(item.currentValue))
        }))
      }
    }
    return outboundState
  },
  { whitelist: ['investment'] }
)

// Financial app persist configuration
export const financialAppPersistConfig = {
  key: 'financial-app',
  storage,
  whitelist: ['user', 'investment'],
  blacklist: ['transaction'], // Don't persist transaction history
  transforms: [financialDataTransform],
  // Custom state reconciler for financial data
  stateReconciler: (inboundState, originalState, reducedState) => {
    return {
      ...reducedState,
      user: {
        ...reducedState.user,
        // Only persist non-sensitive user data
        profile: {
          firstName: inboundState.user?.profile?.firstName,
          lastName: inboundState.user?.profile?.lastName,
          email: inboundState.user?.profile?.email,
          // Don't persist sensitive fields
          ssn: undefined,
          bankDetails: undefined
        },
        preferences: inboundState.user?.preferences || {}
      },
      investment: {
        ...reducedState.investment,
        portfolio: inboundState.investment?.portfolio || [],
        watchlist: inboundState.investment?.watchlist || [],
        // Don't persist loading states
        loading: false,
        error: null
      }
    }
  }
}

// Usage in store configuration
import { financialAppPersistConfig } from './financialPersistConfig'

const persistedReducer = persistReducer(financialAppPersistConfig, rootReducer)
```

### 6. Slice Requirements Checklist

#### ✅ Basic Requirements
- [ ] Use createSlice from Redux Toolkit
- [ ] Define clear initial state
- [ ] Create meaningful action names
- [ ] Use Immer for immutable updates
- [ ] Export actions and selectors
- [ ] Include loading and error states

#### ✅ Financial App Specific
- [ ] Include proper data normalization
- [ ] Add financial calculations in selectors
- [ ] Include proper error handling
- [ ] Add data validation where needed
- [ ] Include audit trail for critical actions

#### ✅ Redux Persist Integration
- [ ] Configure selective persistence (whitelist/blacklist)
- [ ] Don't persist sensitive data (tokens, auth state)
- [ ] Don't persist UI state (loading, errors)
- [ ] Use transforms for data encryption/decryption
- [ ] Include migration strategies for state updates
- [ ] Consider custom storage for sensitive data

#### ✅ Performance
- [ ] Use createSelector for memoized selectors
- [ ] Avoid unnecessary re-renders
- [ ] Include proper data structure for lookups
- [ ] Use normalized state for complex data

