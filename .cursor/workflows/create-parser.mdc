#### KYC Parsers
```javascript
// src/store/parsers/kyc.parsers.js

// Parse KYC status response
export const parseKYCStatusResponse = (response) => {
  if (!response || !response.data) {
    return {
      status: 'pending',
      documents: [],
      lastUpdated: null
    }
  }

  return {
    status: response.data.status,
    documents: response.data.documents?.map(doc => ({
      id: doc.id,
      type: doc.type,
      status: doc.status,
      uploadedAt: doc.uploaded_at,
      verifiedAt: doc.verified_at,
      rejectionReason: doc.rejection_reason
    })) || [],
    lastUpdated: response.data.last_updated
  }
}

// Parse KYC submission response
export const parseKYCSubmissionResponse = (response) => {
  if (!response || !response.data) {
    return {
      success: false,
      message: 'Submission failed'
    }
  }

  return {
    success: response.data.success,
    message: response.data.message,
    kycId: response.data.kyc_id,
    status: response.data.status
  }
}
```

### 4. Parser Requirements Checklist

#### ✅ Basic Requirements
- [ ] Create parser for each API endpoint
- [ ] Handle null/undefined responses gracefully
- [ ] Transform API response to app-friendly format
- [ ] Use consistent naming conventions (camelCase)
- [ ] Parse numeric values with parseFloat/parseInt
- [ ] Handle nested objects and arrays properly

#### ✅ Financial App Specific
- [ ] Parse monetary values correctly
- [ ] Handle percentage calculations
- [ ] Transform date strings to proper format
- [ ] Include proper error handling for invalid data
- [ ] Validate required fields before parsing

#### ✅ Error Handling
- [ ] Return default values for failed parsing
- [ ] Log parsing errors for debugging
- [ ] Handle malformed API responses
- [ ] Include fallback values for missing data

### 5. Parser Usage in API Services
```javascript
// src/store/api/investment.apislice.js
import { baseApi } from './baseApi'
import { 
  parseFundsResponse, 
  parseFundDetailsResponse,
  parsePortfolioResponse 
} from 'store/parsers/investment.parsers'

export const investmentApi = baseApi.injectEndpoints({
  endpoints: (builder) => ({
    getFunds: builder.query({
      query: (params) => ({
        url: '/funds',
        params
      }),
      transformResponse: parseFundsResponse,
      providesTags: ['Fund']
    }),
    
    getFundById: builder.query({
      query: (id) => `/funds/${id}`,
      transformResponse: parseFundDetailsResponse,
      providesTags: (result, error, id) => [{ type: 'Fund', id }]
    }),
    
    getPortfolio: builder.query({
      query: () => '/portfolio',
      transformResponse: parsePortfolioResponse,
      providesTags: ['Portfolio']
    })
  })
})
```

### 6. Testing Template
```javascript
// src/store/parsers/__tests__/fund.parsers.test.js
import { 
  parseFundsResponse, 
  parseFundDetailsResponse 
} from '../fund.parsers'

describe('fund.parsers', () => {
  describe('parseFundsResponse', () => {
    it('handles null response', () => {
      const result = parseFundsResponse(null)
      expect(result).toEqual({
        funds: [],
        pagination: {
          page: 1,
          limit: 20,
          total: 0,
          totalPages: 0
        }
      })
    })

    it('parses valid response correctly', () => {
      const response = {
        data: [
          {
            id: '1',
            name: 'Test Fund',
            nav: '150.25',
            category: 'Equity',
            risk_level: 'High',
            returns: '12.5',
            aum: '1000000',
            expense_ratio: '1.5'
          }
        ],
        pagination: {
          page: 1,
          limit: 20,
          total: 1,
          total_pages: 1
        }
      }

      const result = parseFundsResponse(response)
      expect(result.funds).toHaveLength(1)
      expect(result.funds[0]).toEqual({
        id: '1',
        name: 'Test Fund',
        nav: 150.25,
        category: 'Equity',
        riskLevel: 'High',
        returns: 12.5,
        aum: 1000000,
        expenseRatio: 1.5
      })
    })
  })
})
