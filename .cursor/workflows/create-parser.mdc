#### Investment Parsers
```javascript
// src/store/parsers/investment.parsers.js

// Parse portfolio response
export const parsePortfolioResponse = (response) => {
  if (!response || !response.data) {
    return {
      investments: [],
      totalValue: 0,
      totalGain: 0,
      totalGainPercentage: 0
    }
  }

  const investments = response.data.investments?.map(investment => ({
    id: investment.id,
    fundId: investment.fund_id,
    fundName: investment.fund_name,
    units: parseFloat(investment.units),
    averagePrice: parseFloat(investment.average_price),
    currentPrice: parseFloat(investment.current_price),
    investedAmount: parseFloat(investment.invested_amount),
    currentValue: parseFloat(investment.current_value),
    gain: parseFloat(investment.gain),
    gainPercentage: parseFloat(investment.gain_percentage),
    investmentType: investment.investment_type,
    startDate: investment.start_date,
    lastTransactionDate: investment.last_transaction_date
  })) || []

  return {
    investments,
    totalValue: parseFloat(response.data.total_value || 0),
    totalGain: parseFloat(response.data.total_gain || 0),
    totalGainPercentage: parseFloat(response.data.total_gain_percentage || 0)
  }
}

