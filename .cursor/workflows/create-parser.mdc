# Create API Parser Workflow

## API Parser Creation Checklist

### 1. File Structure
- **Location**: `src/store/parsers/domainName.parsers.js`
- **Naming**: kebab-case with `.parsers.js` suffix
- **Pattern**: One parser file per domain/feature

### 2. Parser Template
```javascript
// src/store/parsers/fund.parsers.js

// Parse funds list response
export const parseFundsResponse = (response) => {
  if (!response || !response.data) {
    return {
      funds: [],
      pagination: {
        page: 1,
        limit: 20,
        total: 0,
        totalPages: 0
      }
    }
  }

  return {
    funds: response.data.map(fund => ({
      id: fund.id,
      name: fund.name,
      nav: parseFloat(fund.nav),
      category: fund.category,
      riskLevel: fund.risk_level,
      returns: parseFloat(fund.returns),
      aum: parseFloat(fund.aum),
      expenseRatio: parseFloat(fund.expense_ratio),
      fundManager: fund.fund_manager,
      inceptionDate: fund.inception_date
    })),
    pagination: {
      page: response.pagination?.page || 1,
      limit: response.pagination?.limit || 20,
      total: response.pagination?.total || 0,
      totalPages: response.pagination?.total_pages || 0
    }
  }
}

// Parse fund details response
export const parseFundDetailsResponse = (response) => {
  if (!response || !response.data) {
    return null
  }

  return {
    id: response.data.id,
    name: response.data.name,
    nav: parseFloat(response.data.nav),
    category: response.data.category,
    riskLevel: response.data.risk_level,
    returns: parseFloat(response.data.returns),
    aum: parseFloat(response.data.aum),
    expenseRatio: parseFloat(response.data.expense_ratio),
    description: response.data.description,
    fundManager: response.data.fund_manager,
    inceptionDate: response.data.inception_date,
    performance: response.data.performance?.map(p => ({
      period: p.period,
      returns: parseFloat(p.returns)
    })) || []
  }
}

// Parse fund performance response
export const parseFundPerformanceResponse = (response) => {
  if (!response || !response.data) {
    return {
      performance: [],
      benchmark: null
    }
  }

  return {
    performance: response.data.performance?.map(p => ({
      date: p.date,
      nav: parseFloat(p.nav),
      returns: parseFloat(p.returns)
    })) || [],
    benchmark: response.data.benchmark ? {
      name: response.data.benchmark.name,
      returns: parseFloat(response.data.benchmark.returns)
    } : null
  }
}
```

### 3. Financial App Parser Examples

#### User/Auth Parsers
```javascript
// src/store/parsers/auth.parsers.js

// Parse login response
export const parseLoginResponse = (response) => {
  if (!response || !response.data) {
    return {
      user: null,
      tokens: null,
      success: false
    }
  }

  return {
    user: {
      id: response.data.user.id,
      firstName: response.data.user.first_name,
      lastName: response.data.user.last_name,
      email: response.data.user.email,
      phone: response.data.user.phone,
      kycStatus: response.data.user.kyc_status,
      bankAccounts: response.data.user.bank_accounts?.map(account => ({
        id: account.id,
        accountNumber: account.account_number,
        bankName: account.bank_name,
        ifscCode: account.ifsc_code,
        isDefault: account.is_default
      })) || []
    },
    tokens: {
      accessToken: response.data.access_token,
      refreshToken: response.data.refresh_token,
      expiresIn: response.data.expires_in
    },
    success: true
  }
}

// Parse user profile response
export const parseUserProfileResponse = (response) => {
  if (!response || !response.data) {
    return null
  }

  return {
    id: response.data.id,
    firstName: response.data.first_name,
    lastName: response.data.last_name,
    email: response.data.email,
    phone: response.data.phone,
    dateOfBirth: response.data.date_of_birth,
    panNumber: response.data.pan_number,
    aadhaarNumber: response.data.aadhaar_number,
    kycStatus: response.data.kyc_status,
    address: response.data.address ? {
      line1: response.data.address.line_1,
      line2: response.data.address.line_2,
      city: response.data.address.city,
      state: response.data.address.state,
      pincode: response.data.address.pincode,
      country: response.data.address.country
    } : null,
    preferences: response.data.preferences || {}
  }
}
