### 8. Usage Examples

#### In API Calls
```javascript
// src/store/api/auth.apislice.js
import { encryptApiRequest, decryptApiResponse } from 'utils/apiEncryption.utils'

export const authApi = baseApi.injectEndpoints({
  endpoints: (builder) => ({
    login: builder.mutation({
      query: (credentials) => ({
        url: '/auth/login',
        method: 'POST',
        body: encryptApiRequest(credentials)
      }),
      transformResponse: decryptApiResponse
    })
  })
})
```

#### In Forms
```javascript
// src/components/forms/KYCFormComponent.jsx
import { encryptFormData } from 'utils/formEncryption.utils'

const KYCFormComponent = ({ onSubmit }) => {
  const handleSubmit = (formData) => {
    const encryptedData = encryptFormData(formData)
    onSubmit(encryptedData)
  }

  // ... rest of component
}
```

#### In Local Storage
```javascript
// src/hooks/useAuth.hook.js
import { setSecureItem, getSecureItem, removeSecureItem } from 'utils/secureStorage.utils'

const useAuth = () => {
  const setTokens = (tokens) => {
    setSecureItem('auth_tokens', tokens)
  }

  const getTokens = () => {
    return getSecureItem('auth_tokens')
  }

  const clearTokens = () => {
    removeSecureItem('auth_tokens')
  }

  // ... rest of hook
}
```

### 9. Testing Encryption
```javascript
// src/utils/__tests__/encryption.utils.test.js
import { encrypt, decrypt, encryptString, decryptString } from '../encryption.utils'

describe('encryption.utils', () => {
  beforeEach(() => {
    // Mock environment variable
    process.env.REACT_APP_ENABLE_ENCRYPTION = 'true'
  })

  it('encrypts and decrypts data correctly', () => {
    const testData = { name: 'John', ssn: '123-45-6789' }
    
    const encrypted = encrypt(testData)
    const decrypted = decrypt(encrypted)
    
    expect(decrypted).toEqual(testData)
  })

  it('encrypts and decrypts strings correctly', () => {
    const testString = 'sensitive-data'
    
    const encrypted = encryptString(testString)
    const decrypted = decryptString(encrypted)
    
    expect(decrypted).toBe(testString)
  })

  it('handles encryption errors gracefully', () => {
    const invalidData = undefined
    
    const encrypted = encrypt(invalidData)
    expect(encrypted).toBe(invalidData)
  })
})
```

### 10. Security Best Practices
- [ ] Use strong encryption keys in production
- [ ] Rotate encryption keys regularly
- [ ] Never log encrypted data
- [ ] Handle encryption errors gracefully
- [ ] Test encryption/decryption thoroughly
- [ ] Use different keys for different data types
- [ ] Implement key management strategy