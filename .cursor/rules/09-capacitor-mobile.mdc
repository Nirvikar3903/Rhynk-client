### Touch-Optimized Components
```javascript
// src/components/mobile/TouchButtonComponent.jsx
import React from 'react'
import { Button } from '@mui/material'
import { isMobile } from 'utils/platform.utils'

const TouchButtonComponent = ({ children, ...props }) => {
  return (
    <Button
      {...props}
      sx={{
        minHeight: isMobile() ? 48 : 36, // Larger touch targets on mobile
        minWidth: isMobile() ? 48 : 36,
        fontSize: isMobile() ? '1rem' : '0.875rem',
        px: isMobile() ? 3 : 2,
        py: isMobile() ? 1.5 : 1,
        touchAction: 'manipulation', // Disable double-tap zoom
        ...props.sx
      }}
    >
      {children}
    </Button>
  )
}

export default TouchButtonComponent
