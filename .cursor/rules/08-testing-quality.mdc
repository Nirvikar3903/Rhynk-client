## Redux Testing

### Slice Testing
```javascript
// src/store/slices/__tests__/auth.slice.test.js
import authReducer, { setSession, clearSession } from '../auth.slice'

describe('auth.slice', () => {
  const initialState = {
    user: null,
    accessToken: null,
    refreshToken: null,
    isAuthenticated: false
  }

  it('should handle initial state', () => {
    expect(authReducer(undefined, {})).toEqual(initialState)
  })

  it('should handle setSession', () => {
    const payload = {
      user: { id: '1', username: 'demo' },
      accessToken: 'access-token',
      refreshToken: 'refresh-token'
    }

    const actual = authReducer(initialState, setSession(payload))
    expect(actual.user).toEqual(payload.user)
    expect(actual.isAuthenticated).toBe(true)
  })

  it('should handle clearSession', () => {
    const loggedInState = {
      user: { id: '1' },
      accessToken: 'token',
      refreshToken: 'refresh',
      isAuthenticated: true
    }

    const actual = authReducer(loggedInState, clearSession())
    expect(actual).toEqual(initialState)
  })
})
```

### RTK Query Testing
```javascript
// src/store/api/__tests__/auth.apislice.test.js
import { renderHook, waitFor } from '@testing-library/react'
import { Provider } from 'react-redux'
import { configureStore } from '@reduxjs/toolkit'
import { authApi } from '../auth.apislice'

const createTestStore = () => {
  return configureStore({
    reducer: {
      [authApi.reducerPath]: authApi.reducer
    },
    middleware: (getDefaultMiddleware) =>
      getDefaultMiddleware().concat(authApi.middleware)
  })
}

describe('authApi', () => {
  let store

  beforeEach(() => {
    store = createTestStore()
  })

  it('should call login and resolve with a session', async () => {
    const wrapper = ({ children }) => <Provider store={store}>{children}</Provider>

    const { result } = renderHook(() => authApi.useLoginMutation(), { wrapper })
    const [login] = result.current

    await login({
      email: 'user@rhynk.app',
      password: 'hunter2hunter2',
      deviceId: 'device-1',
      deviceType: 'WEB'
    })

    await waitFor(() => {
      expect(result.current[1].isSuccess).toBe(true)
    })
  })
})
```

