# Testing & Quality Assurance

## Testing Stack
- **Unit Testing**: React Testing Library + Jest
- **E2E Testing**: Cypress or Playwright (recommended)
- **Accessibility Testing**: axe-core + jest-axe
- **Visual Testing**: Storybook (optional)
- **Auto Test Generation**: Pre-commit hooks for dynamic test creation

## React Testing Library Patterns

### Component Testing
```javascript
// src/components/__tests__/FundCard.test.jsx
import React from 'react'
import { render, screen, fireEvent } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import FundCard from '../FundCard'

const mockFund = {
  id: '1',
  name: 'HDFC Equity Fund',
  nav: 150.25,
  category: 'Equity',
  riskLevel: 'High'
}

describe('FundCard', () => {
  it('renders fund information correctly', () => {
    render(<FundCard fund={mockFund} />)
    
    expect(screen.getByText('HDFC Equity Fund')).toBeInTheDocument()
    expect(screen.getByText('NAV: ₹150.25')).toBeInTheDocument()
    expect(screen.getByText('Equity')).toBeInTheDocument()
  })

  it('calls onSelect when clicked', async () => {
    const user = userEvent.setup()
    const mockOnSelect = jest.fn()
    
    render(<FundCard fund={mockFund} onSelect={mockOnSelect} />)
    
    await user.click(screen.getByRole('button'))
    expect(mockOnSelect).toHaveBeenCalledWith('1')
  })

  it('shows selected state when isSelected is true', () => {
    render(<FundCard fund={mockFund} isSelected={true} />)
    
    const card = screen.getByRole('button')
    expect(card).toHaveStyle('border: 2px solid #1976d2')
  })
})
```

### Form Testing
```javascript
// src/components/__tests__/InvestmentForm.test.jsx
import React from 'react'
import { render, screen, fireEvent, waitFor } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import InvestmentForm from '../InvestmentForm'

describe('InvestmentForm', () => {
  it('validates required fields', async () => {
    const user = userEvent.setup()
    const mockSubmit = jest.fn()
    
    render(<InvestmentForm onSubmit={mockSubmit} />)
    
    const submitButton = screen.getByRole('button', { name: /create investment/i })
    await user.click(submitButton)
    
    expect(screen.getByText('Investment amount is required')).toBeInTheDocument()
    expect(screen.getByText('Duration is required')).toBeInTheDocument()
    expect(mockSubmit).not.toHaveBeenCalled()
  })

  it('submits form with valid data', async () => {
    const user = userEvent.setup()
    const mockSubmit = jest.fn()
    
    render(<InvestmentForm onSubmit={mockSubmit} />)
    
    await user.type(screen.getByLabelText(/investment amount/i), '10000')
    await user.type(screen.getByLabelText(/duration/i), '12')
    await user.selectOptions(screen.getByLabelText(/risk profile/i), 'moderate')
    
    const submitButton = screen.getByRole('button', { name: /create investment/i })
    await user.click(submitButton)
    
    await waitFor(() => {
      expect(mockSubmit).toHaveBeenCalledWith({
        amount: 10000,
        duration: 12,
        riskProfile: 'moderate',
        fundId: '',
        startDate: expect.any(String)
      })
    })
  })

  it('shows loading state during submission', async () => {
    const user = userEvent.setup()
    const mockSubmit = jest.fn(() => new Promise(resolve => setTimeout(resolve, 100)))
    
    render(<InvestmentForm onSubmit={mockSubmit} />)
    
    await user.type(screen.getByLabelText(/investment amount/i), '10000')
    await user.type(screen.getByLabelText(/duration/i), '12')
    
    const submitButton = screen.getByRole('button', { name: /create investment/i })
    await user.click(submitButton)
    
    expect(screen.getByText('Processing...')).toBeInTheDocument()
    expect(submitButton).toBeDisabled()
  })
})
```

### Custom Hook Testing
```javascript
// src/hooks/__tests__/usePortfolio.test.js
import { renderHook, act } from '@testing-library/react'
import { Provider } from 'react-redux'
import { configureStore } from '@reduxjs/toolkit'
import { usePortfolio } from '../usePortfolio'

const createMockStore = (initialState = {}) => {
  return configureStore({
    reducer: {
      investment: (state = initialState, action) => state
    }
  })
}

describe('usePortfolio', () => {
  it('calculates portfolio value correctly', () => {
    const mockInvestments = [
      { id: '1', units: 100, averagePrice: 50 },
      { id: '2', units: 200, averagePrice: 25 }
    ]
    
    const mockMarketData = {
      '1': { nav: 60 },
      '2': { nav: 30 }
    }
    
    const store = createMockStore({
      investments: mockInvestments,
      marketData: mockMarketData
    })
    
    const wrapper = ({ children }) => (
      <Provider store={store}>{children}</Provider>
    )
    
    const { result } = renderHook(() => usePortfolio(), { wrapper })
    
    expect(result.current.totalValue).toBe(12000) // (100 * 60) + (200 * 30)
    expect(result.current.totalGain).toBe(2000) // 12000 - 10000
    expect(result.current.totalGainPercentage).toBe(20) // (2000 / 10000) * 100
  })
})
```

## Redux Testing

### Slice Testing
```javascript
// src/store/slices/__tests__/investmentSlice.test.js
import investmentReducer, { 
  setFunds, 
  setSelectedFund, 
  setLoading 
} from '../investmentSlice'

describe('investmentSlice', () => {
  const initialState = {
    funds: [],
    selectedFund: null,
    loading: false,
    error: null
  }

  it('should handle initial state', () => {
    expect(investmentReducer(undefined, {})).toEqual(initialState)
  })

  it('should handle setFunds', () => {
    const funds = [
      { id: '1', name: 'Fund 1', nav: 100 },
      { id: '2', name: 'Fund 2', nav: 200 }
    ]
    
    const actual = investmentReducer(initialState, setFunds(funds))
    expect(actual.funds).toEqual(funds)
  })

  it('should handle setSelectedFund', () => {
    const fund = { id: '1', name: 'Fund 1', nav: 100 }
    const actual = investmentReducer(initialState, setSelectedFund(fund))
    expect(actual.selectedFund).toEqual(fund)
  })

  it('should handle setLoading', () => {
    const actual = investmentReducer(initialState, setLoading(true))
    expect(actual.loading).toBe(true)
  })
})
```

### RTK Query Testing
```javascript
// src/store/api/__tests__/investmentApi.test.js
import { renderHook, waitFor } from '@testing-library/react'
import { Provider } from 'react-redux'
import { configureStore } from '@reduxjs/toolkit'
import { investmentApi } from '../investmentApi'

const createTestStore = () => {
  return configureStore({
    reducer: {
      [investmentApi.reducerPath]: investmentApi.reducer
    },
    middleware: (getDefaultMiddleware) =>
      getDefaultMiddleware().concat(investmentApi.middleware)
  })
}

describe('investmentApi', () => {
  let store

  beforeEach(() => {
    store = createTestStore()
  })

  it('should fetch funds', async () => {
    const wrapper = ({ children }) => (
      <Provider store={store}>{children}</Provider>
    )

    const { result } = renderHook(() => investmentApi.useGetFundsQuery(), { wrapper })

    await waitFor(() => {
      expect(result.current.isSuccess).toBe(true)
    })

    expect(result.current.data).toBeDefined()
  })
})
```

