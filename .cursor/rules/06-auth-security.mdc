### Input Validation & Sanitization
```javascript
// src/utils/validation.js
import DOMPurify from 'dompurify'

export const sanitizeInput = (input) => {
  return DOMPurify.sanitize(input)
}

export const validateFinancialInput = (value) => {
  // Remove any non-numeric characters except decimal point
  const cleaned = value.replace(/[^0-9.]/g, '')
  
  // Ensure only one decimal point
  const parts = cleaned.split('.')
  if (parts.length > 2) {
    return parts[0] + '.' + parts.slice(1).join('')
  }
  
  return cleaned
}
```

### XSS Protection
```javascript
// src/components/SafeText.jsx
import React from 'react'
import DOMPurify from 'dompurify'

const SafeText = ({ content, ...props }) => {
  const sanitizedContent = DOMPurify.sanitize(content)
  
  return (
    <span 
      {...props}
      dangerouslySetInnerHTML={{ __html: sanitizedContent }}
    />
  )
}

export default SafeText
```

## API Security

### Request Interceptors
```javascript
// src/store/api/baseApi.js
import { baseQuery } from './baseQuery'

const baseQueryWithReauth = async (args, api, extraOptions) => {
  let result = await baseQuery(args, api, extraOptions)
  
  if (result.error && result.error.status === 401) {
    // Try to refresh token
    const refreshResult = await api.dispatch(
      authApi.endpoints.refreshToken.initiate()
    )
    
    if (refreshResult.data) {
      // Retry original request with new token
      result = await baseQuery(args, api, extraOptions)
    } else {
      // Refresh failed, redirect to login
      api.dispatch(clearUser())
      window.location.href = '/login'
    }
  }
  
  return result
}

export const baseApi = createApi({
  reducerPath: 'api',
  baseQuery: baseQueryWithReauth,
  // ... other config
})
```

### CSRF Protection
```javascript
// src/utils/csrf.js
export const getCSRFToken = () => {
  return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
}

// Include in API requests
const baseQuery = fetchBaseQuery({
  baseUrl: process.env.REACT_APP_API_BASE_URL,
  prepareHeaders: (headers) => {
    const csrfToken = getCSRFToken()
    if (csrfToken) {
      headers.set('X-CSRF-Token', csrfToken)
    }
    return headers
  }
})
```

## Financial Data Security

### Sensitive Data Handling
```javascript
// src/utils/financialSecurity.js
import CryptoJS from 'crypto-js'

export const encryptSensitiveData = (data, key) => {
  return CryptoJS.AES.encrypt(JSON.stringify(data), key).toString()
}

export const decryptSensitiveData = (encryptedData, key) => {
  const bytes = CryptoJS.AES.decrypt(encryptedData, key)
  return JSON.parse(bytes.toString(CryptoJS.enc.Utf8))
}

// Mask sensitive data in logs
export const maskSensitiveData = (data) => {
  const masked = { ...data }
  
  if (masked.panNumber) {
    masked.panNumber = masked.panNumber.replace(/(.{2}).*(.{2})/, '$1****$2')
  }
  
  if (masked.accountNumber) {
    masked.accountNumber = masked.accountNumber.replace(/(.{4}).*(.{4})/, '$1****$2')
  }
  
  return masked
}
```

### Secure Storage for Financial Data
```javascript
// src/utils/secureStorage.js
export const secureStorage = {
  setItem: (key, value) => {
    const encrypted = encryptSensitiveData(value, process.env.REACT_APP_ENCRYPTION_KEY)
    localStorage.setItem(key, encrypted)
  },
  
  getItem: (key) => {
    const encrypted = localStorage.getItem(key)
    if (!encrypted) return null
    
    try {
      return decryptSensitiveData(encrypted, process.env.REACT_APP_ENCRYPTION_KEY)
    } catch (error) {
      console.error('Failed to decrypt data:', error)
      return null
    }
  },
  
  removeItem: (key) => {
    localStorage.removeItem(key)
  }
}
```

## Compliance & Privacy

### Data Privacy
```javascript
// src/utils/privacy.js
export const anonymizeUserData = (userData) => {
  return {
    ...userData,
    email: userData.email.replace(/(.{2}).*(@.*)/, '$1***$2'),
    phone: userData.phone.replace(/(.{3}).*(.{3})/, '$1***$2')
  }
}

export const shouldLogData = (data) => {
  // Don't log sensitive financial data in production
  if (process.env.NODE_ENV === 'production') {
    return maskSensitiveData(data)
  }
  return data
}
```

### Cookie Consent
```javascript
// src/components/CookieConsent.jsx
import React, { useState, useEffect } from 'react'
import { Button, Dialog, DialogTitle, DialogContent, DialogActions } from '@mui/material'

const CookieConsent = () => {
  const [open, setOpen] = useState(false)

  useEffect(() => {
    const consent = localStorage.getItem('cookie-consent')
    if (!consent) {
      setOpen(true)
    }
  }, [])

  const handleAccept = () => {
    localStorage.setItem('cookie-consent', 'accepted')
    setOpen(false)
  }

  const handleDecline = () => {
    localStorage.setItem('cookie-consent', 'declined')
    setOpen(false)
  }

  return (
    <Dialog open={open} maxWidth="sm" fullWidth>
      <DialogTitle>Cookie Consent</DialogTitle>
      <DialogContent>
        <p>
          We use cookies to enhance your experience and analyze our traffic. 
          By clicking "Accept", you consent to our use of cookies.
        </p>
      </DialogContent>
      <DialogActions>
        <Button onClick={handleDecline}>Decline</Button>
        <Button onClick={handleAccept} variant="contained">Accept</Button>
      </DialogActions>
    </Dialog>
  )
}

export default CookieConsent
```