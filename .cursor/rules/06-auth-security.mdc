# Authentication & Security

## Token Storage Strategy

### Preferred: HttpOnly Cookies
```javascript
// src/utils/auth.js
import { encrypt, decrypt } from './cryptoService'

// Server-side: Set HttpOnly cookies
const setAuthCookies = (res, tokens) => {
  res.cookie('accessToken', tokens.accessToken, {
    httpOnly: true,
    secure: process.env.NODE_ENV === 'production',
    sameSite: 'strict',
    maxAge: 15 * 60 * 1000 // 15 minutes
  })
  
  res.cookie('refreshToken', tokens.refreshToken, {
    httpOnly: true,
    secure: process.env.NODE_ENV === 'production',
    sameSite: 'strict',
    maxAge: 7 * 24 * 60 * 60 * 1000 // 7 days
  })
}

// Client-side: Check for tokens in cookies (handled by browser)
const getAuthToken = () => {
  // Browser automatically includes HttpOnly cookies in requests
  // No need to manually retrieve them
  return null // Token is handled by browser
}
```

### Fallback: Encrypted localStorage
```javascript
// src/utils/auth.js
import { encrypt, decrypt } from './cryptoService'

const TOKEN_KEY = 'auth_tokens'
const ENCRYPTION_KEY = process.env.REACT_APP_ENCRYPTION_KEY

// Store encrypted tokens
export const setAuthTokens = (tokens) => {
  try {
    const encryptedTokens = encrypt(JSON.stringify(tokens), ENCRYPTION_KEY)
    localStorage.setItem(TOKEN_KEY, encryptedTokens)
  } catch (error) {
    console.error('Failed to store auth tokens:', error)
  }
}

// Retrieve and decrypt tokens
export const getAuthTokens = () => {
  try {
    const encryptedTokens = localStorage.getItem(TOKEN_KEY)
    if (!encryptedTokens) return null
    
    const decryptedTokens = decrypt(encryptedTokens, ENCRYPTION_KEY)
    return JSON.parse(decryptedTokens)
  } catch (error) {
    console.error('Failed to retrieve auth tokens:', error)
    clearAuthTokens()
    return null
  }
}

// Clear tokens on logout
export const clearAuthTokens = () => {
  localStorage.removeItem(TOKEN_KEY)
}
```

## Refresh Token Mechanism

### Token Refresh Implementation
```javascript
// src/store/api/authApi.js
import { baseApi } from './baseApi'

export const authApi = baseApi.injectEndpoints({
  endpoints: (builder) => ({
    login: builder.mutation({
      query: (credentials) => ({
        url: '/auth/login',
        method: 'POST',
        body: credentials
      }),
      invalidatesTags: ['User']
    }),
    
    refreshToken: builder.mutation({
      query: (refreshToken) => ({
        url: '/auth/refresh',
        method: 'POST',
        body: { refreshToken }
      })
    }),
    
    logout: builder.mutation({
      query: () => ({
        url: '/auth/logout',
        method: 'POST'
      }),
      invalidatesTags: ['User']
    })
  })
})

// Token refresh interceptor
const refreshTokenIfNeeded = async (token) => {
  if (!token || isTokenExpired(token)) {
    const refreshToken = getRefreshToken()
    if (refreshToken) {
      try {
        const response = await authApi.endpoints.refreshToken.initiate(refreshToken)
        const newTokens = response.data
        setAuthTokens(newTokens)
        return newTokens.accessToken
      } catch (error) {
        clearAuthTokens()
        throw new Error('Token refresh failed')
      }
    }
    throw new Error('No valid refresh token')
  }
  return token
}
```

### Token Expiration Check
```javascript
// src/utils/tokenUtils.js
export const isTokenExpired = (token) => {
  if (!token) return true
  
  try {
    const payload = JSON.parse(atob(token.split('.')[1]))
    const currentTime = Date.now() / 1000
    return payload.exp < currentTime
  } catch (error) {
    return true
  }
}

export const getTokenExpirationTime = (token) => {
  try {
    const payload = JSON.parse(atob(token.split('.')[1]))
    return new Date(payload.exp * 1000)
  } catch (error) {
    return null
  }
}
```

## Authentication Flow

### Login Process
```javascript
// src/containers/LoginContainer.jsx
import { useLoginMutation } from 'store/api/authApi'
import { setAuthTokens, clearAuthTokens } from 'utils/auth'

const LoginContainer = () => {
  const [login, { isLoading, error }] = useLoginMutation()
  const navigate = useNavigate()

  const handleLogin = async (credentials) => {
    try {
      const response = await login(credentials).unwrap()
      
      // Store tokens securely
      setAuthTokens({
        accessToken: response.accessToken,
        refreshToken: response.refreshToken
      })
      
      // Update user state
      dispatch(setUser(response.user))
      
      // Navigate to dashboard
      navigate('/dashboard')
    } catch (error) {
      console.error('Login failed:', error)
      // Error is handled by the mutation
    }
  }

  return (
    <LoginForm 
      onSubmit={handleLogin}
      loading={isLoading}
      error={error}
    />
  )
}
```

### Logout Process
```javascript
// src/containers/LogoutContainer.jsx
import { useLogoutMutation } from 'store/api/authApi'
import { clearAuthTokens } from 'utils/auth'

const LogoutContainer = () => {
  const [logout] = useLogoutMutation()
  const dispatch = useDispatch()
  const navigate = useNavigate()

  const handleLogout = async () => {
    try {
      // Call logout API
      await logout().unwrap()
    } catch (error) {
      console.error('Logout API failed:', error)
    } finally {
      // Always clear local state
      clearAuthTokens()
      dispatch(clearUser())
      navigate('/login')
    }
  }

  return (
    <Button onClick={handleLogout}>
      Logout
    </Button>
  )
}
```

## Security Best Practices

### HTTPS Enforcement
```javascript
// src/utils/security.js
export const enforceHTTPS = () => {
  if (process.env.NODE_ENV === 'production' && window.location.protocol !== 'https:') {
    window.location.replace(window.location.href.replace('http:', 'https:'))
  }
}

// Call in main.jsx
enforceHTTPS()
```

### Content Security Policy
```javascript
