# Performance Optimization

## React Performance Patterns

### React.memo for Component Memoization
```javascript
// ✅ Correct - Memoize expensive components
import React, { memo } from 'react'
import PropTypes from 'prop-types'

const MessageBubble = memo(({ message, onReact, isOwnMessage }) => {
  return (
    <Card
      onClick={() => onReact(message.id)}
      sx={{
        alignSelf: isOwnMessage ? 'flex-end' : 'flex-start',
        cursor: 'pointer'
      }}
    >
      <CardContent>
        <Typography variant="body2">{message.text}</Typography>
        <Typography variant="caption">{message.formattedTime}</Typography>
      </CardContent>
    </Card>
  )
})

MessageBubble.propTypes = {
  message: PropTypes.shape({
    id: PropTypes.string.isRequired,
    text: PropTypes.string.isRequired,
    formattedTime: PropTypes.string
  }).isRequired,
  onReact: PropTypes.func.isRequired,
  isOwnMessage: PropTypes.bool
}

MessageBubble.displayName = 'MessageBubble'

export default MessageBubble
```

### useCallback for Function Memoization
```javascript
// ✅ Correct - Memoize callback functions
import React, { useState, useCallback, memo } from 'react'

const MessageList = memo(({ messages, onMessageReact }) => {
  const [selectedMessageId, setSelectedMessageId] = useState(null)

  // Memoize the reaction handler
  const handleMessageReact = useCallback((messageId) => {
    setSelectedMessageId(messageId)
    onMessageReact?.(messageId)
  }, [onMessageReact])

  return (
    <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1 }}>
      {messages.map(message => (
        <MessageBubble
          key={message.id}
          message={message}
          isOwnMessage={message.senderId === selectedMessageId}
          onReact={handleMessageReact}
        />
      ))}
    </Box>
  )
})

export default MessageList
```

### useMemo for Expensive Calculations
```javascript
// ✅ Correct - Memoize expensive calculations
import React, { useMemo } from 'react'

const RoomQueueSummary = ({ queue, members }) => {
  // Memoize queue stats — recomputing this on every keystroke elsewhere
  // in the room (e.g. chat typing) would be wasted work
  const queueStats = useMemo(() => {
    if (!queue.length) {
      return { totalDurationMs: 0, byContributor: {} }
    }

    const totalDurationMs = queue.reduce((sum, track) => sum + track.durationMs, 0)

    const byContributor = queue.reduce((acc, track) => {
      acc[track.addedBy] = (acc[track.addedBy] || 0) + 1
      return acc
    }, {})

    return { totalDurationMs, byContributor }
  }, [queue])

  return (
    <div>
      <Typography variant="h6">
        Queue length: {Math.round(queueStats.totalDurationMs / 60000)} min
      </Typography>
    </div>
  )
}

export default RoomQueueSummary
```

## Code Splitting & Lazy Loading

### Route-Based Code Splitting
```javascript
// src/router/index.jsx
import React, { lazy, Suspense } from 'react'
import { Routes, Route } from 'react-router-dom'
import { Box, CircularProgress } from '@mui/material'

// Lazy load pages
const ConversationsPage = lazy(() => import('pages/conversations/ConversationsPage'))
const MusicRoomPage = lazy(() => import('pages/music-rooms/MusicRoomPage'))
const StoriesPage = lazy(() => import('pages/stories/StoriesPage'))
const ProfilePage = lazy(() => import('pages/profile/ProfilePage'))

// Loading component
const PageLoader = () => (
  <Box display="flex" justifyContent="center" alignItems="center" minHeight="400px">
    <CircularProgress />
  </Box>
)

const AppRouter = () => {
  return (
    <Suspense fallback={<PageLoader />}>
      <Routes>
        <Route path="/conversations" element={<ConversationsPage />} />
        <Route path="/music-rooms/:roomId" element={<MusicRoomPage />} />
        <Route path="/stories" element={<StoriesPage />} />
        <Route path="/profile" element={<ProfilePage />} />
      </Routes>
    </Suspense>
  )
}

export default AppRouter
```

### Dynamic Imports for Heavy/Optional Libraries
The music-room provider adapters and things like an emoji picker are good
candidates for dynamic import — they're not needed on first paint and, in
the YouTube fallback's case, pull in a third-party iframe script:

```javascript
// src/features/music-room/providers/loadYouTubeProvider.js
export const loadYouTubeProvider = async () => {
  const { YouTubeProvider } = await import('./YouTubeProvider')
  return YouTubeProvider
}

// Usage — only load the YouTube IFrame provider if JioSaavn is unavailable
const useMusicProvider = (providerType) => {
  const [Provider, setProvider] = useState(null)

  useEffect(() => {
    if (providerType === 'youtube') {
      loadYouTubeProvider().then((mod) => setProvider(() => mod))
    }
  }, [providerType])

  return Provider
}
```

```javascript
// Dynamic import for an emoji picker on message reactions — not needed
// until the user opens the reaction menu
const EmojiPicker = lazy(() => import('components/common/EmojiPickerComponent'))

const ReactionMenu = ({ onSelect }) => {
  const [open, setOpen] = useState(false)

  return (
    <>
      <Button onClick={() => setOpen(true)}>React</Button>
      {open && (
        <Suspense fallback={<CircularProgress size={16} />}>
          <EmojiPicker onSelect={onSelect} />
        </Suspense>
      )}
    </>
  )
}
```

