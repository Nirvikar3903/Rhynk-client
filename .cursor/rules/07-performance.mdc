## Memory Management

### Cleanup Effects
```javascript
// ✅ Correct - Cleanup subscriptions and timers
import React, { useEffect, useRef } from 'react'

const RealTimePrice = ({ fundId }) => {
  const wsRef = useRef(null)
  const intervalRef = useRef(null)

  useEffect(() => {
    // WebSocket connection
    wsRef.current = new WebSocket(`wss://api.example.com/prices/${fundId}`)
    
    // Polling fallback
    intervalRef.current = setInterval(() => {
      fetchPrice(fundId)
    }, 30000)

    return () => {
      // Cleanup WebSocket
      if (wsRef.current) {
        wsRef.current.close()
      }
      
      // Cleanup interval
      if (intervalRef.current) {
        clearInterval(intervalRef.current)
      }
    }
  }, [fundId])

  return <div>Price updates...</div>
}
```

### Avoid Memory Leaks
```javascript
// ✅ Correct - Cancel ongoing requests
import React, { useEffect, useRef } from 'react'

const FundData = ({ fundId }) => {
  const abortControllerRef = useRef(null)

  useEffect(() => {
    // Create new AbortController for each request
    abortControllerRef.current = new AbortController()
    
    const fetchData = async () => {
      try {
        const response = await fetch(`/api/funds/${fundId}`, {
          signal: abortControllerRef.current.signal
        })
        const data = await response.json()
        setFundData(data)
      } catch (error) {
        if (error.name !== 'AbortError') {
          console.error('Failed to fetch fund data:', error)
        }
      }
    }

    fetchData()

    return () => {
      // Cancel ongoing request on cleanup
      if (abortControllerRef.current) {
        abortControllerRef.current.abort()
      }
    }
  }, [fundId])

  return <div>Fund data...</div>
}
```

## Image Optimization

### Lazy Loading Images
```javascript
// src/components/LazyImage.jsx
import React, { useState, useRef, useEffect } from 'react'
import { Box, Skeleton } from '@mui/material'

const LazyImage = ({ src, alt, ...props }) => {
  const [isLoaded, setIsLoaded] = useState(false)
  const [isInView, setIsInView] = useState(false)
  const imgRef = useRef(null)

  useEffect(() => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setIsInView(true)
          observer.disconnect()
        }
      },
      { threshold: 0.1 }
    )

    if (imgRef.current) {
      observer.observe(imgRef.current)
    }

    return () => observer.disconnect()
  }, [])

  return (
    <Box ref={imgRef} {...props}>
      {isInView && (
        <img
          src={src}
          alt={alt}
          onLoad={() => setIsLoaded(true)}
          style={{ display: isLoaded ? 'block' : 'none' }}
        />
      )}
      {!isLoaded && <Skeleton variant="rectangular" width="100%" height="200px" />}
    </Box>
  )
}

export default LazyImage
```

