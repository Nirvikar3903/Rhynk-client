### Dynamic Imports for Heavy Libraries
```javascript
// src/utils/chartUtils.js
export const loadAmCharts = async () => {
  const am4core = await import('@amcharts/amcharts4/core')
  const am4charts = await import('@amcharts/amcharts4/charts')
  const am4themes = await import('@amcharts/amcharts4/themes/animated')
  
  am4core.useTheme(am4themes.default)
  
  return { am4core, am4charts }
}

// Usage in component
const ChartComponent = ({ data, type = 'line' }) => {
  const [chartLib, setChartLib] = useState(null)
  const chartRef = useRef(null)

  useEffect(() => {
    loadAmCharts().then(setChartLib)
  }, [])

  useEffect(() => {
    if (chartLib && chartRef.current) {
      const { am4core, am4charts } = chartLib
      
      // Create chart
      const chart = am4core.create(chartRef.current, am4charts.XYChart)
      chart.data = data
      
      // Configure chart based on type
      if (type === 'line') {
        const lineSeries = chart.series.push(new am4charts.LineSeries())
        lineSeries.dataFields.valueY = 'value'
        lineSeries.dataFields.dateX = 'date'
      }
      
      return () => {
        chart.dispose()
      }
    }
  }, [chartLib, data, type])

  if (!chartLib) {
    return <CircularProgress />
  }

  return <div ref={chartRef} style={{ width: '100%', height: '400px' }} />
}
```

