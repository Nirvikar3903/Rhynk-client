# Performance Optimization

## React Performance Patterns

### React.memo for Component Memoization
```javascript
// ✅ Correct - Memoize expensive components
import React, { memo } from 'react'
import PropTypes from 'prop-types'

const FundCard = memo(({ fund, onSelect, isSelected }) => {
  return (
    <Card 
      onClick={() => onSelect(fund.id)}
      sx={{ 
        border: isSelected ? '2px solid #1976d2' : '1px solid #e0e0e0',
        cursor: 'pointer'
      }}
    >
      <CardContent>
        <Typography variant="h6">{fund.name}</Typography>
        <Typography variant="body2">NAV: ₹{fund.nav}</Typography>
        <Typography variant="caption">{fund.category}</Typography>
      </CardContent>
    </Card>
  )
})

FundCard.propTypes = {
  fund: PropTypes.shape({
    id: PropTypes.string.isRequired,
    name: PropTypes.string.isRequired,
    nav: PropTypes.number.isRequired,
    category: PropTypes.string
  }).isRequired,
  onSelect: PropTypes.func.isRequired,
  isSelected: PropTypes.bool
}

FundCard.displayName = 'FundCard'

export default FundCard
```

### useCallback for Function Memoization
```javascript
// ✅ Correct - Memoize callback functions
import React, { useState, useCallback, memo } from 'react'

const FundList = memo(({ funds, onFundSelect }) => {
  const [selectedFundId, setSelectedFundId] = useState(null)

  // Memoize the selection handler
  const handleFundSelect = useCallback((fundId) => {
    setSelectedFundId(fundId)
    onFundSelect?.(fundId)
  }, [onFundSelect])

  // Memoize the fund selection handler
  const handleFundClick = useCallback((fund) => {
    handleFundSelect(fund.id)
  }, [handleFundSelect])

  return (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {funds.map(fund => (
        <FundCard
          key={fund.id}
          fund={fund}
          isSelected={selectedFundId === fund.id}
          onSelect={handleFundClick}
        />
      ))}
    </div>
  )
})

export default FundList
```

### useMemo for Expensive Calculations
```javascript
// ✅ Correct - Memoize expensive calculations
import React, { useMemo } from 'react'

const PortfolioSummary = ({ investments, marketData }) => {
  // Memoize portfolio calculations
  const portfolioStats = useMemo(() => {
    if (!investments.length || !marketData) {
      return {
        totalValue: 0,
        totalGain: 0,
        totalGainPercentage: 0,
        topPerformer: null
      }
    }

    const totalValue = investments.reduce((sum, investment) => {
      const currentPrice = marketData[investment.fundId]?.nav || 0
      return sum + (investment.units * currentPrice)
    }, 0)

    const totalInvested = investments.reduce((sum, investment) => {
      return sum + investment.investedAmount
    }, 0)

    const totalGain = totalValue - totalInvested
    const totalGainPercentage = totalInvested > 0 ? (totalGain / totalInvested) * 100 : 0

    const topPerformer = investments.reduce((top, investment) => {
      const currentPrice = marketData[investment.fundId]?.nav || 0
      const gain = (currentPrice - investment.averagePrice) / investment.averagePrice
      const topGain = top ? (top.currentPrice - top.averagePrice) / top.averagePrice : -1
      return gain > topGain ? { ...investment, currentPrice, gain } : top
    }, null)

    return {
      totalValue,
      totalGain,
      totalGainPercentage,
      topPerformer
    }
  }, [investments, marketData])

  return (
    <div>
      <Typography variant="h4">
        Portfolio Value: ₹{portfolioStats.totalValue.toLocaleString()}
      </Typography>
      <Typography 
        variant="h6" 
        color={portfolioStats.totalGain >= 0 ? 'success.main' : 'error.main'}
      >
        {portfolioStats.totalGain >= 0 ? '+' : ''}₹{portfolioStats.totalGain.toLocaleString()}
        ({portfolioStats.totalGainPercentage.toFixed(2)}%)
      </Typography>
    </div>
  )
}

export default PortfolioSummary
```

