}
```

### Custom Styling with SX
```javascript
// ✅ Correct - Complex styling with SX
const MessageBubble = ({ message, isOwnMessage }) => {
  return (
    <Card
      sx={{
        maxWidth: '70%',
        alignSelf: isOwnMessage ? 'flex-end' : 'flex-start',
        background: isOwnMessage
          ? 'linear-gradient(135deg, #6C5CE7 0%, #764ba2 100%)'
          : 'background.paper',
        color: isOwnMessage ? 'white' : 'text.primary',
        borderRadius: 2,
        p: 1.5,
        '& .message-text': {
          fontWeight: 400
        },
        '& .message-timestamp': {
          fontSize: '0.7rem',
          opacity: 0.7
        }
      }}
    >
      <Box className="message-text">{message.text}</Box>
      <Box className="message-timestamp">{message.formattedTime}</Box>
    </Card>
  )
}
```

## Responsive Design Standards

### MUI Breakpoints
```javascript
// MUI breakpoints (xs, sm, md, lg, xl)
const breakpoints = {
  xs: 0,      // Extra small devices (phones)
  sm: 600,    // Small devices (tablets)
  md: 900,    // Medium devices (desktops)
  lg: 1200,   // Large devices (large desktops)
  xl: 1536    // Extra large devices
}

// SX responsive grid
const ResponsiveGrid = () => (
  <Box
    sx={{
      display: 'grid',
      gridTemplateColumns: {
        xs: '1fr',
        sm: 'repeat(2, 1fr)',
        md: 'repeat(3, 1fr)',
        lg: 'repeat(4, 1fr)'
      },
      gap: 2
    }}
  >
    {/* Grid items */}
  </Box>
)
```

