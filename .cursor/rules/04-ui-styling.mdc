### Custom MUI Components
Create reusable MUI wrappers in `src/components/mui/`:

```javascript
// src/components/mui/AppTextFieldComponent.jsx
import React from 'react'
import { TextField } from '@mui/material'
import PropTypes from 'prop-types'

const AppTextFieldComponent = ({
  label,
  value,
  onChange,
  error,
  helperText,
  required = false,
  type = 'text',
  ...props
}) => {
  return (
    <TextField
      label={label}
      value={value}
      onChange={onChange}
      error={!!error}
      helperText={error || helperText}
      required={required}
      type={type}
      variant="outlined"
      fullWidth
      margin="normal"
      {...props}
    />
  )
}

AppTextFieldComponent.propTypes = {
  label: PropTypes.string.isRequired,
  value: PropTypes.string.isRequired,
  onChange: PropTypes.func.isRequired,
  error: PropTypes.string,
  helperText: PropTypes.string,
  required: PropTypes.bool,
  type: PropTypes.string
}

export default AppTextFieldComponent
```

## MUI SX-Based Styling

### SX Prop Usage
Use MUI's SX prop for all custom styling needs:

```javascript
// ✅ Correct - SX-based styling
const ConversationList = ({ conversations }) => {
  return (
    <Box
      sx={{
        display: 'grid',
        gridTemplateColumns: {
          xs: '1fr',
          md: 'repeat(2, 1fr)',
          lg: 'repeat(3, 1fr)'
        },
        gap: 2,
        p: 2
      }}
    >
      {conversations.map(conversation => (
        <Card
          key={conversation.id}
          sx={{
            bgcolor: 'background.paper',
            borderRadius: 2,
            boxShadow: 2,
            p: 2,
            transition: 'all 0.2s ease-in-out',
            '&:hover': {
              boxShadow: 4,
              transform: 'translateY(-2px)'
            }
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            {conversation.name}
          </Typography>
          <Typography variant="body2" sx={{ color: 'text.secondary' }}>
            {conversation.lastMessagePreview}
          </Typography>
        </Card>
      ))}
    </Box>
  )
}
```

### Responsive Design with SX
```javascript
// ✅ Correct - Responsive patterns using SX
const LoginForm = () => {
  return (
    <Box
      sx={{
        width: '100%',
        maxWidth: '480px',
        mx: 'auto'
      }}
    >
      <Grid container spacing={2}>
        <Grid item xs={12}>
          <AppTextFieldComponent label="Email" fullWidth />
        </Grid>
        <Grid item xs={12}>
          <AppTextFieldComponent label="Password" type="password" fullWidth />
        </Grid>
      </Grid>
    </Box>
