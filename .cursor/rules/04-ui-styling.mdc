      {subtitle && (
        <Typography className="chart-subtitle">
          {subtitle}
        </Typography>
      )}
      {children}
    </Box>
  )
}

export default ChartContainer
```

## Accessibility Standards

### Color Contrast
- Ensure minimum WCAG AA contrast ratios
- Use MUI's built-in color system
- Test with color contrast analyzers

### Focus Management
```javascript
// ✅ Correct - Proper focus management with SX
const AccessibleButton = ({ children, ...props }) => {
  return (
    <Button
      {...props}
      sx={{
        '&:focus': {
          outline: '2px solid',
          outlineColor: 'primary.main',
          outlineOffset: '2px'
        },
        '&:focus-visible': {
          outline: '2px solid',
          outlineColor: 'primary.main',
          outlineOffset: '2px'
        },
        ...props.sx
      }}
    >
      {children}
    </Button>
  )
}
```

