## Form Validation Patterns

### Custom Validators
```javascript
// src/utils/validators.js
export const customValidators = {
  // PAN validation
  pan: (value) => {
    const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/
    return panRegex.test(value) || 'Invalid PAN format'
  },
  
  // IFSC validation
  ifsc: (value) => {
    const ifscRegex = /^[A-Z]{4}0[A-Z0-9]{6}$/
    return ifscRegex.test(value) || 'Invalid IFSC code'
  },
  
  // Aadhaar validation
  aadhaar: (value) => {
    const aadhaarRegex = /^[0-9]{12}$/
    return aadhaarRegex.test(value) || 'Aadhaar must be 12 digits'
  },
  
  // Phone number validation
  phone: (value) => {
    const phoneRegex = /^[6-9]\d{9}$/
    return phoneRegex.test(value) || 'Invalid phone number'
  },
  
  // Amount validation with range
  amount: (min, max) => (value) => {
    if (value < min) return `Minimum amount is ₹${min}`
    if (value > max) return `Maximum amount is ₹${max}`
    return true
  }
}
```

