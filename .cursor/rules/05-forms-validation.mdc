## Form State Management

### Loading States
```javascript
// ✅ Correct - Proper loading state management
const InvestmentForm = ({ onSubmit }) => {
  const [isSubmitting, setIsSubmitting] = useState(false)
  const [submitError, setSubmitError] = useState(null)

  const {
    control,
    handleSubmit,
    formState: { errors, isValid },
    reset
  } = useForm({
    resolver: yupResolver(investmentSchema),
    mode: 'onChange' // Validate on change for better UX
  })

  const handleFormSubmit = async (data) => {
    setIsSubmitting(true)
    setSubmitError(null)
    
    try {
      await onSubmit(data)
      reset() // Clear form on success
    } catch (error) {
      setSubmitError(error.message || 'Submission failed')
    } finally {
      setIsSubmitting(false)
    }
  }

  return (
    <form onSubmit={handleSubmit(handleFormSubmit)}>
      {/* Form fields */}
      
      {submitError && (
        <Alert severity="error" sx={{ mt: 2 }}>
          {submitError}
        </Alert>
      )}
      
      <Button
        type="submit"
        disabled={!isValid || isSubmitting}
        fullWidth
      >
        {isSubmitting ? 'Processing...' : 'Submit'}
      </Button>
    </form>
  )
}
```

### Error Handling
```javascript
// ✅ Correct - Comprehensive error handling
const FormWithErrorHandling = () => {
  const [serverErrors, setServerErrors] = useState({})

  const {
    control,
    handleSubmit,
    setError,
    clearErrors,
    formState: { errors }
  } = useForm({
    resolver: yupResolver(schema)
  })

  const handleServerError = (field, message) => {
    setError(field, {
      type: 'server',
      message
    })
  }

  const handleFormSubmit = async (data) => {
    try {
      clearErrors() // Clear previous errors
      await submitToAPI(data)
    } catch (error) {
      if (error.field) {
        handleServerError(error.field, error.message)
      } else {
        setServerErrors({ general: error.message })
      }
    }
  }

  return (
    <form onSubmit={handleSubmit(handleFormSubmit)}>
      {/* Form fields with error display */}
      {serverErrors.general && (
        <Alert severity="error">
          {serverErrors.general}
        </Alert>
      )}
    </form>
  )
}
