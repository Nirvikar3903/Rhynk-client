# Forms & Validation

## React Hook Form + Yup Integration

### Form Setup Pattern
```javascript
// src/components/forms/InvestmentForm.jsx
import React from 'react'
import { useForm, Controller } from 'react-hook-form'
import { yupResolver } from '@hookform/resolvers/yup'
import * as yup from 'yup'
import { 
  Button, 
  TextField, 
  FormControl, 
  InputLabel, 
  Select, 
  MenuItem,
  Box,
  Typography
} from '@mui/material'

// Validation schema
const investmentSchema = yup.object({
  amount: yup
    .number()
    .required('Investment amount is required')
    .min(500, 'Minimum investment is ₹500')
    .max(1000000, 'Maximum investment is ₹10,00,000'),
  duration: yup
    .number()
    .required('Duration is required')
    .min(1, 'Minimum duration is 1 month')
    .max(60, 'Maximum duration is 60 months'),
  riskProfile: yup
    .string()
    .required('Risk profile is required')
    .oneOf(['conservative', 'moderate', 'aggressive'], 'Invalid risk profile'),
  fundId: yup
    .string()
    .required('Please select a fund'),
  startDate: yup
    .date()
    .required('Start date is required')
    .min(new Date(), 'Start date cannot be in the past')
})

const InvestmentForm = ({ onSubmit, loading = false }) => {
  const {
    control,
    handleSubmit,
    formState: { errors, isSubmitting },
    watch,
    setValue
  } = useForm({
    resolver: yupResolver(investmentSchema),
    defaultValues: {
      amount: '',
      duration: 12,
      riskProfile: 'moderate',
      fundId: '',
      startDate: new Date().toISOString().split('T')[0]
    }
  })

  const watchedAmount = watch('amount')
  const watchedDuration = watch('duration')

  const handleFormSubmit = async (data) => {
    try {
      await onSubmit(data)
    } catch (error) {
      console.error('Form submission error:', error)
    }
  }

  return (
    <Box component="form" onSubmit={handleSubmit(handleFormSubmit)}>
      <Typography variant="h6" gutterBottom>
        Investment Details
      </Typography>
      
      {/* Investment Amount */}
      <Controller
        name="amount"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            label="Investment Amount (₹)"
            type="number"
            error={!!errors.amount}
            helperText={errors.amount?.message}
            fullWidth
            margin="normal"
            InputProps={{
              startAdornment: <Typography>₹</Typography>
            }}
          />
        )}
      />

      {/* Duration */}
      <Controller
        name="duration"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            label="Duration (months)"
            type="number"
            error={!!errors.duration}
            helperText={errors.duration?.message}
            fullWidth
            margin="normal"
          />
        )}
      />

      {/* Risk Profile */}
      <Controller
        name="riskProfile"
        control={control}
        render={({ field }) => (
          <FormControl fullWidth margin="normal" error={!!errors.riskProfile}>
            <InputLabel>Risk Profile</InputLabel>
            <Select {...field} label="Risk Profile">
              <MenuItem value="conservative">Conservative</MenuItem>
              <MenuItem value="moderate">Moderate</MenuItem>
              <MenuItem value="aggressive">Aggressive</MenuItem>
            </Select>
            {errors.riskProfile && (
              <Typography variant="caption" color="error">
                {errors.riskProfile.message}
              </Typography>
            )}
          </FormControl>
        )}
      />

      {/* Fund Selection */}
      <Controller
        name="fundId"
        control={control}
        render={({ field }) => (
          <FormControl fullWidth margin="normal" error={!!errors.fundId}>
            <InputLabel>Select Fund</InputLabel>
            <Select {...field} label="Select Fund">
              {/* Fund options will be populated from API */}
            </Select>
            {errors.fundId && (
              <Typography variant="caption" color="error">
                {errors.fundId.message}
              </Typography>
            )}
          </FormControl>
        )}
      />

      {/* Start Date */}
      <Controller
        name="startDate"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            label="Start Date"
            type="date"
            error={!!errors.startDate}
            helperText={errors.startDate?.message}
            fullWidth
            margin="normal"
            InputLabelProps={{ shrink: true }}
          />
        )}
      />

      {/* Submit Button */}
      <Button
        type="submit"
        variant="contained"
        fullWidth
        disabled={isSubmitting || loading}
        sx={{ mt: 3, mb: 2 }}
      >
        {isSubmitting || loading ? 'Processing...' : 'Create Investment'}
      </Button>
    </Box>
  )
}

export default InvestmentForm
```

