  // Phone number validation
  phone: (value) => {
    const phoneRegex = /^[6-9]\d{9}$/
    return phoneRegex.test(value) || 'Invalid phone number'
  },
  
  // Amount validation with range
  amount: (min, max) => (value) => {
    if (value < min) return `Minimum amount is ₹${min}`
    if (value > max) return `Maximum amount is ₹${max}`
    return true
  }
}
```

### Conditional Validation
```javascript
// ✅ Correct - Conditional validation based on other fields
const conditionalSchema = yup.object({
  investmentType: yup.string().required(),
  amount: yup.number().required(),
  duration: yup.number().when('investmentType', {
    is: 'sip',
    then: yup.number().min(1, 'SIP duration must be at least 1 month'),
    otherwise: yup.number().min(1, 'Duration must be at least 1 month')
  }),
  frequency: yup.string().when('investmentType', {
    is: 'sip',
    then: yup.string().required('Frequency is required for SIP'),
    otherwise: yup.string()
  })
})
```

## Form Accessibility

### ARIA Labels and Roles
```javascript
// ✅ Correct - Accessible form elements
const AccessibleForm = () => {
  return (
    <form role="form" aria-label="Investment form">
      <TextField
        label="Investment Amount"
        aria-describedby="amount-help"
        aria-required="true"
        error={!!errors.amount}
        helperText={errors.amount?.message}
      />
      
      <div id="amount-help">
        Enter amount between ₹500 and ₹10,00,000
      </div>
      
      <Button
        type="submit"
        aria-label="Submit investment form"
        disabled={isSubmitting}
      >
        {isSubmitting ? 'Processing...' : 'Submit'}
      </Button>
    </form>
  )
}
```

