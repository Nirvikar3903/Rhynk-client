### SIP Order Form
```javascript
// src/schemas/sipOrderSchema.js
import * as yup from 'yup'

export const sipOrderSchema = yup.object({
  fundId: yup.string().required('Fund selection is required'),
  amount: yup
    .number()
    .required('SIP amount is required')
    .min(500, 'Minimum SIP amount is ₹500')
    .max(50000, 'Maximum SIP amount is ₹50,000'),
  frequency: yup
    .string()
    .required('SIP frequency is required')
    .oneOf(['monthly', 'quarterly', 'yearly'], 'Invalid frequency'),
  startDate: yup
    .date()
    .required('Start date is required')
    .min(new Date(), 'Start date cannot be in the past'),
  endDate: yup
    .date()
    .when('startDate', (startDate, schema) => {
      if (startDate) {
        const minEndDate = new Date(startDate)
        minEndDate.setMonth(minEndDate.getMonth() + 1)
        return schema.min(minEndDate, 'End date must be at least 1 month after start date')
      }
      return schema
    }),
  autoDebit: yup.boolean().default(true),
  bankAccountId: yup.string().when('autoDebit', {
    is: true,
    then: yup.string().required('Bank account is required for auto debit'),
    otherwise: yup.string()
  })
})
