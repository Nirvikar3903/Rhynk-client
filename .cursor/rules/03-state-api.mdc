## RTK Query API Integration

### Base API Configuration
```javascript
// src/store/api/baseApi.js
import { createApi, fetchBaseQuery } from '@reduxjs/toolkit/query/react'
import { getAuthToken } from 'utils/auth'

export const baseApi = createApi({
  reducerPath: 'api',
  baseQuery: fetchBaseQuery({
    baseUrl: process.env.REACT_APP_API_BASE_URL,
    prepareHeaders: (headers, { getState }) => {
      const token = getAuthToken()
      if (token) {
        headers.set('authorization', `Bearer ${token}`)
      }
      headers.set('content-type', 'application/json')
      return headers
    }
  }),
  tagTypes: ['User', 'Fund', 'Portfolio', 'Transaction'],
  endpoints: () => ({})
})
```

### API Service Pattern with Parsers
```javascript
// src/store/api/investment.apislice.js
import { baseApi } from './baseApi'
import { parseFundsResponse, parseFundDetailsResponse } from 'store/parsers/fund.parsers'

export const investmentApi = baseApi.injectEndpoints({
  endpoints: (builder) => ({
    // Get all funds
    getFunds: builder.query({
      query: (params = {}) => ({
        url: '/funds',
        params
      }),
      transformResponse: parseFundsResponse,
      providesTags: ['Fund']
    }),
    
    // Get fund details
    getFundById: builder.query({
      query: (id) => `/funds/${id}`,
      providesTags: (result, error, id) => [{ type: 'Fund', id }]
    }),
    
    // Get user portfolio
    getPortfolio: builder.query({
      query: () => '/portfolio',
      providesTags: ['Portfolio']
    }),
    
    // Create SIP order
    createSIPOrder: builder.mutation({
      query: (orderData) => ({
        url: '/orders/sip',
        method: 'POST',
        body: orderData
      }),
      invalidatesTags: ['Portfolio', 'Transaction']
    }),
    
    // Create lumpsum order
    createLumpsumOrder: builder.mutation({
      query: (orderData) => ({
        url: '/orders/lumpsum',
        method: 'POST',
        body: orderData
      }),
      invalidatesTags: ['Portfolio', 'Transaction']
    }),
    
    // Redeem investment
    redeemInvestment: builder.mutation({
      query: (redemptionData) => ({
        url: '/orders/redeem',
        method: 'POST',
        body: redemptionData
      }),
      invalidatesTags: ['Portfolio', 'Transaction']
    })
  })
})

export const {
  useGetFundsQuery,
  useGetFundByIdQuery,
  useGetPortfolioQuery,
  useCreateSIPOrderMutation,
  useCreateLumpsumOrderMutation,
  useRedeemInvestmentMutation
} = investmentApi
```

### Store Registration
```javascript
// src/store/index.js
import { configureStore } from '@reduxjs/toolkit'
import { baseApi } from './api/baseApi'
import investmentReducer from './slices/investmentSlice'
import userReducer from './slices/userSlice'

export const store = configureStore({
  reducer: {
    [baseApi.reducerPath]: baseApi.reducer,
    investment: investmentReducer,
    user: userReducer
  },
  middleware: (getDefaultMiddleware) =>
    getDefaultMiddleware().concat(baseApi.middleware)
})
```

## Cache Invalidation Strategies

### Tag-Based Invalidation
```javascript
// Invalidate related data when creating orders
createSIPOrder: builder.mutation({
  query: (orderData) => ({
    url: '/orders/sip',
    method: 'POST',
    body: orderData
  }),
  invalidatesTags: [
    'Portfolio',     // Refresh portfolio data
    'Transaction',   // Refresh transaction history
    { type: 'Fund', id: 'LIST' } // Refresh fund list if needed
  ]
})
```

### Optimistic Updates
```javascript
// Optimistic update for better UX
updatePortfolio: builder.mutation({
  query: (updates) => ({
    url: '/portfolio',
    method: 'PATCH',
    body: updates
  }),
  async onQueryStarted(updates, { dispatch, queryFulfilled }) {
    // Optimistic update
    const patchResult = dispatch(
      investmentApi.util.updateQueryData('getPortfolio', undefined, (draft) => {
        Object.assign(draft, updates)
      })
    )
    
    try {
      await queryFulfilled
    } catch {
      // Revert on error
      patchResult.undo()
    }
  },
  invalidatesTags: ['Portfolio']
})
```

## No Direct API Calls
- **Never use axios or fetch directly in components**
- All API calls must go through RTK Query
- Use generated hooks in components

```javascript
// ✅ Correct - Use RTK Query hooks
const FundList = () => {
  const { data: funds, error, isLoading } = useGetFundsQuery()
  const [createOrder] = useCreateSIPOrderMutation()
  
  // component logic
}

// ❌ Avoid - Direct API calls
const FundList = () => {
  const [funds, setFunds] = useState([])
  
  useEffect(() => {
    fetch('/api/funds') // Don't do this
      .then(res => res.json())
      .then(setFunds)
  }, [])
}
```