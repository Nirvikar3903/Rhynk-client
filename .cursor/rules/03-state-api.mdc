# State Management & API Integration

## Redux Toolkit with createSlice

### Redux Slice Pattern
```javascript
// src/store/slices/investment.slice.js
import { createSlice, createSelector } from '@reduxjs/toolkit'

const initialState = {
  funds: [],
  selectedFund: null,
  portfolio: [],
  loading: false,
  error: null
}

const investmentSlice = createSlice({
  name: 'investment',
  initialState,
  reducers: {
    setFunds: (state, action) => {
      state.funds = action.payload
    },
    setSelectedFund: (state, action) => {
      state.selectedFund = action.payload
    },
    setLoading: (state, action) => {
      state.loading = action.payload
    },
    setError: (state, action) => {
      state.error = action.payload
    },
    clearError: (state) => {
      state.error = null
    }
  }
})

export const { 
  setFunds, 
  setSelectedFund, 
  setLoading, 
  setError, 
  clearError 
} = investmentSlice.actions

// Selectors
export const selectFunds = (state) => state.investment.funds
export const selectSelectedFund = (state) => state.investment.selectedFund
export const selectPortfolio = (state) => state.investment.portfolio
export const selectInvestmentLoading = (state) => state.investment.loading
export const selectInvestmentError = (state) => state.investment.error

// Memoized selectors
export const selectFundsByCategory = createSelector(
  [selectFunds, (state, category) => category],
  (funds, category) => funds.filter(fund => fund.category === category)
)

export default investmentSlice.reducer
```

## API Response Parsers

### Parser Pattern
```javascript
// src/store/parsers/fund.parsers.js
export const parseFundsResponse = (response) => {
  if (!response || !response.data) {
    return {
      funds: [],
      pagination: {
        page: 1,
        limit: 20,
        total: 0,
        totalPages: 0
      }
    }
  }

  return {
    funds: response.data.map(fund => ({
      id: fund.id,
      name: fund.name,
      nav: parseFloat(fund.nav),
      category: fund.category,
      riskLevel: fund.risk_level,
      returns: parseFloat(fund.returns),
      aum: parseFloat(fund.aum),
      expenseRatio: parseFloat(fund.expense_ratio)
    })),
    pagination: {
      page: response.pagination?.page || 1,
      limit: response.pagination?.limit || 20,
      total: response.pagination?.total || 0,
      totalPages: response.pagination?.total_pages || 0
    }
  }
}

export const parseFundDetailsResponse = (response) => {
  if (!response || !response.data) {
    return null
  }

  return {
    id: response.data.id,
    name: response.data.name,
    nav: parseFloat(response.data.nav),
    category: response.data.category,
    riskLevel: response.data.risk_level,
    returns: parseFloat(response.data.returns),
    aum: parseFloat(response.data.aum),
    expenseRatio: parseFloat(response.data.expense_ratio),
    description: response.data.description,
    fundManager: response.data.fund_manager,
    inceptionDate: response.data.inception_date
  }
}
```

## Redux Persist Configuration

### Per-Slice Persist Strategy
```javascript
// src/store/slices/user.slice.js
import { createSlice } from '@reduxjs/toolkit'
import { persistReducer } from 'redux-persist'
import storage from 'redux-persist/lib/storage'

const userPersistConfig = {
  key: 'user',
  storage,
  whitelist: ['profile', 'preferences'], // Don't persist tokens
  blacklist: ['loading', 'error']
}

const userSlice = createSlice({
  name: 'user',
  initialState: {
    profile: null,
    preferences: {},
    loading: false,
    error: null
  },
  reducers: {
    setUser: (state, action) => {
      state.profile = action.payload
    },
    updatePreferences: (state, action) => {
      state.preferences = { ...state.preferences, ...action.payload }
    }
  }
})

// Apply persist to this slice only
export default persistReducer(userPersistConfig, userSlice.reducer)
```

### Store Configuration
```javascript
// src/store/index.js
import { configureStore } from '@reduxjs/toolkit'
import { persistStore } from 'redux-persist'
import userReducer from './slices/user.slice'
import investmentReducer from './slices/investment.slice'

export const store = configureStore({
  reducer: {
    user: userReducer, // Already persisted
    investment: investmentReducer, // Already persisted
  },
  middleware: (getDefaultMiddleware) =>
    getDefaultMiddleware({
      serializableCheck: {
        ignoredActions: [FLUSH, REHYDRATE, PAUSE, PERSIST, PURGE, REGISTER]
      }
    })
})

export const persistor = persistStore(store)
```

